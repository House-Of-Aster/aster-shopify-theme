{% doc %}
  Renders the theme's storefront header: global logo or shop title,
  main menu, customer account entry, and cart link. Composed directly
  in layout/theme.liquid so it wraps every page.
{% enddoc %}

<header {{ block.shopify_attributes }}>
  <div class="header__brand">
    {% if settings.logo != blank %}
      <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
        <span
          class="header__logo"
          aria-hidden="true"
          style="--aster-logo-width: {{ settings.logo_width }}px; --aster-logo-width-mobile: {{ settings.logo_mobile_width }}px; --aster-logo-aspect-ratio: {{ settings.logo.aspect_ratio | default: 3 }}; --aster-logo-colour: {{ settings.logo_colour }}; --aster-logo-mask: url('{{ settings.logo | image_url: width: 1200 }}');"
        ></span>
      </a>
    {% else %}
      <h2 class="header__title">
        {{ shop.name | link_to: routes.root_url }}
      </h2>
    {% endif %}
  </div>

  <div class="header__menu">
    {% for link in block.settings.menu.links %}
      {{ link.title | link_to: link.url }}
    {% endfor %}
  </div>

  <div class="header__icons">
    {% if shop.customer_accounts_enabled %}
      <shopify-account menu="{{ block.settings.customer_account_menu }}">
        {{ 'icon-account.svg' | inline_asset_content }}
      </shopify-account>
    {% endif %}

    <a href="{{ routes.cart_url }}">
      {% if cart.item_count > 0 %}
        <sup>{{ cart.item_count }}</sup>
      {% endif %}

      {{ 'icon-cart.svg' | inline_asset_content }}
    </a>
  </div>
</header>

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
