{% doc %}
  Renders the global Aster storefront header.

  Navigation is intentionally unified across desktop and mobile. The real
  header remains completely stationary while one non-modal dialog panel opens
  beneath its measured bottom edge. This keeps announcement/header geometry
  unchanged and avoids duplicated header markup inside the navigation layer.
{% enddoc %}

<header
  class="aster-header full-width color-{{ block.settings.color_scheme }}"
  data-aster-header
  data-aster-menu-root
  {{ block.shopify_attributes }}
>
  <div class="aster-header__inner">
    <button
      class="aster-header__icon-button aster-header__menu-toggle"
      type="button"
      aria-label="Open navigation"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="AsterHeaderMenu-{{ block.id }}"
      data-aster-menu-open
    >
      <span class="aster-header__hamburger-box" aria-hidden="true">
        <span class="aster-header__hamburger-inner"></span>
      </span>
    </button>

    <div class="aster-header__brand">
      {% if settings.logo != blank %}
        <a class="aster-header__brand-link" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
          <span
            class="aster-header__logo"
            aria-hidden="true"
            style="--aster-logo-width: {{ settings.logo_width }}px; --aster-logo-width-mobile: {{ settings.logo_mobile_width }}px; --aster-logo-aspect-ratio: {{ settings.logo.aspect_ratio | default: 3 }}; --aster-logo-mask: url('{{ settings.logo | image_url: width: 1200 }}');"
          ></span>
        </a>
      {% else %}
        <a class="aster-header__title" href="{{ routes.root_url }}">{{ shop.name | escape }}</a>
      {% endif %}
    </div>

    <div class="aster-header__utilities">
      <a class="aster-header__icon-button aster-header__search" href="{{ routes.search_url }}" aria-label="Search">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
          <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.4"></circle>
          <path d="m16 16 4.25 4.25" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
        </svg>
      </a>

      {% if shop.customer_accounts_enabled %}
        <span class="aster-header__account" aria-label="Account">
          <shopify-account menu="{{ block.settings.customer_account_menu }}">
            {{ 'icon-account.svg' | inline_asset_content }}
          </shopify-account>
        </span>
      {% endif %}

      <a
        class="aster-header__icon-button aster-header__cart"
        href="{{ routes.cart_url }}"
        aria-label="Cart{% if cart.item_count > 0 %}, {{ cart.item_count }} items{% endif %}"
      >
        {{ 'icon-cart.svg' | inline_asset_content }}
        {% if cart.item_count > 0 %}
          <span class="aster-header__cart-count" aria-hidden="true">{{ cart.item_count }}</span>
        {% endif %}
      </a>
    </div>
  </div>

  <dialog
    id="AsterHeaderMenu-{{ block.id }}"
    class="aster-header__menu-dialog color-{{ block.settings.color_scheme }}"
    aria-labelledby="AsterHeaderMenuLabel-{{ block.id }}"
    tabindex="-1"
    scroll-lock
    data-aster-menu-dialog
  >
    <div class="aster-header__menu-overlay">
      <div class="aster-header__menu-content">
        <h2
          id="AsterHeaderMenuLabel-{{ block.id }}"
          class="visually-hidden"
          tabindex="-1"
          data-aster-menu-label
        >
          Navigation
        </h2>

        <div class="aster-header__menu-tools">
          <form class="aster-header__menu-search" action="{{ routes.search_url }}" method="get" role="search">
            <label class="visually-hidden" for="AsterMenuSearch-{{ block.id }}">Search Aster</label>
            <div class="aster-header__menu-search-field">
              <input
                id="AsterMenuSearch-{{ block.id }}"
                class="form-control aster-header__menu-search-input"
                type="search"
                name="q"
                value="{{ search.terms | escape }}"
                placeholder="Search Aster"
                autocomplete="off"
              >
              <button class="aster-header__menu-search-submit" type="submit" aria-label="Search">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
                  <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.4"></circle>
                  <path d="m16 16 4.25 4.25" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
                </svg>
              </button>
            </div>
          </form>

          {% if shop.customer_accounts_enabled %}
            <a class="aster-header__menu-account" href="{{ routes.account_url }}" aria-label="Account">
              {{ 'icon-account.svg' | inline_asset_content }}
            </a>
          {% endif %}
        </div>

        <nav class="aster-header__menu-nav" aria-label="Main navigation">
          {% for link in block.settings.menu.links %}
            <div class="aster-header__menu-group">
              <a
                class="aster-header__menu-link{% if link.current %} is-active{% endif %}"
                href="{{ link.url }}"
                {% if link.current %}aria-current="page"{% endif %}
              >
                {{ link.title | escape }}
              </a>

              {% if link.links != blank %}
                <div class="aster-header__menu-children">
                  {% for child_link in link.links %}
                    <a
                      class="aster-header__menu-child{% if child_link.current %} is-active{% endif %}"
                      href="{{ child_link.url }}"
                      {% if child_link.current %}aria-current="page"{% endif %}
                    >
                      {{ child_link.title | escape }}
                    </a>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          {% endfor %}

          {% if block.settings.menu == blank and request.design_mode %}
            <p class="aster-header__menu-empty">Choose a navigation menu in the Header settings.</p>
          {% endif %}
        </nav>
      </div>
    </div>
  </dialog>

  <script src="{{ 'aster-header-menu.js' | asset_url }}" defer></script>
</header>

{% stylesheet %}
  .aster-header-shell {
    position: sticky;
    top: 0;
    z-index: 30;
  }

  .aster-header {
    --icon-stroke-width: 1.35;
    width: 100%;
    min-height: 84px;
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .aster-header__inner {
    width: min(1400px, calc(100% - 40px));
    min-height: 84px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 24px;
  }

  .aster-header a,
  .aster-header button {
    color: inherit;
  }

  .aster-header a {
    text-decoration: none;
  }

  .aster-header__brand {
    justify-self: center;
    min-width: 0;
  }

  .aster-header__brand-link,
  .aster-header__title {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .aster-header__title {
    font-family: var(--font-display--family);
    font-size: 30px;
    line-height: 1;
  }

  .aster-header__logo {
    display: block;
    width: min(var(--aster-logo-width), 30vw);
    aspect-ratio: var(--aster-logo-aspect-ratio);
    background: var(--color-foreground);
    -webkit-mask-image: var(--aster-logo-mask);
    mask-image: var(--aster-logo-mask);
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: contain;
    mask-size: contain;
  }

  .aster-header__utilities {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .aster-header__icon-button,
  .aster-header__account {
    position: relative;
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
  }

  .aster-header__icon-button {
    border: 0;
    padding: 0;
    background: transparent;
    cursor: pointer;
    transition: opacity var(--aster-duration-interaction, 180ms) ease;
  }

  .aster-header__menu-toggle {
    justify-self: start;
  }

  .aster-header__icon-button svg,
  .aster-header__account svg {
    width: 20px;
    height: 20px;
  }

  .aster-header__account shopify-account {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .aster-header__cart-count {
    position: absolute;
    top: 4px;
    right: 2px;
    min-width: 18px;
    height: 18px;
    padding-inline: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: var(--color-foreground);
    color: var(--color-background);
    font-size: 10px;
    font-weight: var(--font-body-bolder-weight);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  /*
    Squeeze motion adapted from jonsuh/hamburgers (MIT),
    Copyright (c) 2016 Jonathan Suh. See THIRD_PARTY_NOTICES.md.
  */
  .aster-header__hamburger-box {
    position: relative;
    width: 24px;
    height: 16px;
    display: block;
  }

  .aster-header__hamburger-inner,
  .aster-header__hamburger-inner::before,
  .aster-header__hamburger-inner::after {
    position: absolute;
    left: 0;
    width: 24px;
    height: 1.5px;
    border-radius: 999px;
    background: currentColor;
  }

  .aster-header__hamburger-inner {
    top: 50%;
    display: block;
    margin-top: -0.75px;
    transition-duration: 75ms;
    transition-property: transform;
    transition-timing-function: cubic-bezier(0.55, 0.055, 0.675, 0.19);
  }

  .aster-header__hamburger-inner::before,
  .aster-header__hamburger-inner::after {
    content: '';
    display: block;
  }

  .aster-header__hamburger-inner::before {
    top: -6px;
    transition:
      top 75ms 120ms ease,
      opacity 75ms ease;
  }

  .aster-header__hamburger-inner::after {
    bottom: -6px;
    transition:
      bottom 75ms 120ms ease,
      transform 75ms cubic-bezier(0.55, 0.055, 0.675, 0.19);
  }

  .aster-header__menu-toggle.is-active .aster-header__hamburger-inner {
    transform: rotate(45deg);
    transition-delay: 120ms;
    transition-timing-function: cubic-bezier(0.215, 0.61, 0.355, 1);
  }

  .aster-header__menu-toggle.is-active .aster-header__hamburger-inner::before {
    top: 0;
    opacity: 0;
    transition:
      top 75ms ease,
      opacity 75ms 120ms ease;
  }

  .aster-header__menu-toggle.is-active .aster-header__hamburger-inner::after {
    bottom: 0;
    transform: rotate(-90deg);
    transition:
      bottom 75ms ease,
      transform 75ms 120ms cubic-bezier(0.215, 0.61, 0.355, 1);
  }

  .aster-header__menu-dialog {
    --aster-menu-top: 84px;
    position: fixed;
    inset: var(--aster-menu-top) 0 0;
    width: 100vw;
    max-width: none;
    height: auto;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: auto;
    overscroll-behavior: contain;
    background: var(--color-background);
    color: var(--color-foreground);
    opacity: 0;
    transform: translateY(-8px);
    z-index: 1;
    transition:
      opacity 220ms ease,
      transform 260ms var(--aster-ease-out, cubic-bezier(0.22, 1, 0.36, 1));
  }

  .aster-header__menu-dialog[open] {
    display: block;
  }

  .aster-header__menu-dialog.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .aster-header__menu-dialog::backdrop {
    background: transparent;
  }

  .aster-header__menu-overlay {
    min-height: 100%;
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .aster-header__menu-content {
    width: min(1400px, calc(100% - 40px));
    min-height: 100%;
    margin: 0 auto;
    padding-block: clamp(28px, 5vh, 64px) 48px;
  }

  .aster-header__menu-tools {
    width: min(100%, 760px);
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .aster-header__menu-search {
    width: min(100%, 620px);
  }

  .aster-header__menu-search-field {
    position: relative;
  }

  .aster-header__menu-search-input {
    width: 100%;
    padding-right: 56px;
  }

  .aster-header__menu-search-submit,
  .aster-header__menu-account {
    width: 44px;
    height: 44px;
    border: 0;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .aster-header__menu-search-submit {
    position: absolute;
    top: 50%;
    right: 4px;
    transform: translateY(-50%);
  }

  .aster-header__menu-search-submit svg,
  .aster-header__menu-account svg {
    width: 20px;
    height: 20px;
  }

  .aster-header__menu-account {
    display: none;
    flex: 0 0 auto;
  }

  .aster-header__menu-nav {
    width: min(100%, 760px);
    margin-top: clamp(48px, 7vh, 96px);
    display: grid;
    gap: clamp(24px, 3vw, 42px);
  }

  .aster-header__menu-group {
    display: grid;
    gap: 14px;
  }

  .aster-header__menu-link {
    width: fit-content;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    font-size: clamp(46px, 6vw, 82px);
    line-height: 0.96;
    letter-spacing: var(--font-heading-letter-spacing);
    text-transform: var(--font-heading-transform);
    opacity: 0.78;
    transition:
      opacity var(--aster-duration-interaction, 180ms) ease,
      transform 220ms var(--aster-ease-out, cubic-bezier(0.22, 1, 0.36, 1));
  }

  .aster-header__menu-children {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
  }

  .aster-header__menu-child {
    width: fit-content;
    font-family: var(--font-navigation--family);
    font-weight: var(--font-navigation-weight);
    text-transform: var(--font-navigation-transform);
    font-size: 13px;
    line-height: 1.3;
    opacity: 0.62;
    transition: opacity var(--aster-duration-interaction, 180ms) ease;
  }

  .aster-header__menu-link.is-active,
  .aster-header__menu-child.is-active {
    opacity: 1;
  }

  .aster-header__menu-empty {
    font-family: var(--font-navigation--family);
    opacity: 0.55;
  }

  @media (hover: hover) and (pointer: fine) {
    .aster-header__icon-button:hover,
    .aster-header__menu-search-submit:hover,
    .aster-header__menu-account:hover,
    .aster-header__menu-child:hover {
      opacity: 1;
    }

    .aster-header__menu-link:hover {
      opacity: 1;
      transform: translateX(4px);
    }
  }

  .aster-header a:focus-visible,
  .aster-header button:focus-visible,
  .aster-header shopify-account:focus-visible,
  .aster-header__menu-dialog:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  @media (max-width: 749px) {
    .aster-header {
      min-height: 68px;
    }

    .aster-header__inner {
      width: calc(100% - 30px);
      min-height: 68px;
      gap: 8px;
    }

    .aster-header__logo {
      width: min(var(--aster-logo-width-mobile), 42vw);
    }

    .aster-header__utilities {
      gap: 0;
    }

    .aster-header__account {
      display: none;
    }

    .aster-header__menu-content {
      width: calc(100% - 30px);
      padding-block: 24px 36px;
    }

    .aster-header__menu-tools {
      width: 100%;
    }

    .aster-header__menu-search {
      flex: 1 1 auto;
      width: auto;
    }

    .aster-header__menu-account {
      width: 52px;
      height: 52px;
      display: inline-flex;
    }

    .aster-header__menu-nav {
      width: 100%;
      margin-top: clamp(42px, 7vh, 72px);
      gap: 24px;
    }

    .aster-header__menu-link {
      font-size: clamp(40px, 13vw, 62px);
    }
  }

  @media (max-width: 420px) {
    .aster-header__search {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aster-header__icon-button,
    .aster-header__hamburger-inner,
    .aster-header__hamburger-inner::before,
    .aster-header__hamburger-inner::after,
    .aster-header__menu-dialog,
    .aster-header__menu-link,
    .aster-header__menu-child {
      transition: none;
    }

    .aster-header__menu-link:hover {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "Customer account menu",
      "default": "customer-account-main-menu"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-2"
    }
  ]
}
{% endschema %}