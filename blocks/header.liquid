{% doc %}
  Renders the global Aster storefront header.

  Navigation is intentionally unified across desktop and mobile: a single
  burger control opens one native dialog-based full-screen navigation layer.
  This keeps the chrome visually clean and avoids duplicated menu markup.
{% enddoc %}

<header
  class="aster-header full-width color-{{ block.settings.color_scheme }}"
  data-aster-header
  data-aster-menu-root
  {{ block.shopify_attributes }}
>
  <div class="aster-header__inner">
    <button
      class="aster-header__icon-button aster-header__menu-toggle"
      type="button"
      aria-label="Open navigation"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="AsterHeaderMenu-{{ block.id }}"
      data-aster-menu-open
    >
      <span class="aster-header__menu-icon" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>

    <div class="aster-header__brand">
      {% if settings.logo != blank %}
        <a class="aster-header__brand-link" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
          <span
            class="aster-header__logo"
            aria-hidden="true"
            style="--aster-logo-width: {{ settings.logo_width }}px; --aster-logo-width-mobile: {{ settings.logo_mobile_width }}px; --aster-logo-aspect-ratio: {{ settings.logo.aspect_ratio | default: 3 }}; --aster-logo-mask: url('{{ settings.logo | image_url: width: 1200 }}');"
          ></span>
        </a>
      {% else %}
        <a class="aster-header__title" href="{{ routes.root_url }}">{{ shop.name | escape }}</a>
      {% endif %}
    </div>

    <div class="aster-header__utilities">
      <a class="aster-header__icon-button aster-header__search" href="{{ routes.search_url }}" aria-label="Search">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
          <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.4"></circle>
          <path d="m16 16 4.25 4.25" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
        </svg>
      </a>

      {% if shop.customer_accounts_enabled %}
        <span class="aster-header__account" aria-label="Account">
          <shopify-account menu="{{ block.settings.customer_account_menu }}">
            {{ 'icon-account.svg' | inline_asset_content }}
          </shopify-account>
        </span>
      {% endif %}

      <a
        class="aster-header__icon-button aster-header__cart"
        href="{{ routes.cart_url }}"
        aria-label="Cart{% if cart.item_count > 0 %}, {{ cart.item_count }} items{% endif %}"
      >
        {{ 'icon-cart.svg' | inline_asset_content }}
        {% if cart.item_count > 0 %}
          <span class="aster-header__cart-count" aria-hidden="true">{{ cart.item_count }}</span>
        {% endif %}
      </a>
    </div>
  </div>

  <dialog
    id="AsterHeaderMenu-{{ block.id }}"
    class="aster-header__menu-dialog color-{{ block.settings.color_scheme }}"
    aria-labelledby="AsterHeaderMenuLabel-{{ block.id }}"
    tabindex="-1"
    scroll-lock
    data-aster-menu-dialog
  >
    <div class="aster-header__menu-overlay">
      <div class="aster-header__menu-topbar">
        <button
          class="aster-header__icon-button aster-header__menu-close"
          type="button"
          aria-label="Close navigation"
          data-aster-menu-close
        >
          <span class="aster-header__menu-icon" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </button>

        <div class="aster-header__brand">
          {% if settings.logo != blank %}
            <span
              class="aster-header__logo"
              aria-hidden="true"
              style="--aster-logo-width: {{ settings.logo_width }}px; --aster-logo-width-mobile: {{ settings.logo_mobile_width }}px; --aster-logo-aspect-ratio: {{ settings.logo.aspect_ratio | default: 3 }}; --aster-logo-mask: url('{{ settings.logo | image_url: width: 1200 }}');"
            ></span>
          {% else %}
            <span class="aster-header__title">{{ shop.name | escape }}</span>
          {% endif %}
        </div>

        <span class="aster-header__menu-topbar-spacer" aria-hidden="true"></span>
      </div>

      <div class="aster-header__menu-content">
        <h2
          id="AsterHeaderMenuLabel-{{ block.id }}"
          class="visually-hidden"
          tabindex="-1"
          data-aster-menu-label
        >
          Navigation
        </h2>

        <nav class="aster-header__menu-nav" aria-label="Main navigation">
          {% for link in block.settings.menu.links %}
            <div class="aster-header__menu-group">
              <a
                class="aster-header__menu-link{% if link.current %} is-active{% endif %}"
                href="{{ link.url }}"
                {% if link.current %}aria-current="page"{% endif %}
              >
                {{ link.title | escape }}
              </a>

              {% if link.links != blank %}
                <div class="aster-header__menu-children">
                  {% for child_link in link.links %}
                    <a
                      class="aster-header__menu-child{% if child_link.current %} is-active{% endif %}"
                      href="{{ child_link.url }}"
                      {% if child_link.current %}aria-current="page"{% endif %}
                    >
                      {{ child_link.title | escape }}
                    </a>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          {% endfor %}

          {% if block.settings.menu == blank and request.design_mode %}
            <p class="aster-header__menu-empty">Choose a navigation menu in the Header settings.</p>
          {% endif %}
        </nav>
      </div>

      <div class="aster-header__menu-footer">
        <a href="{{ routes.search_url }}">Search</a>
        {% if shop.customer_accounts_enabled %}
          <a href="{{ routes.account_url }}">Account</a>
        {% endif %}
      </div>
    </div>
  </dialog>

  <script src="{{ 'aster-header-menu.js' | asset_url }}" defer></script>
</header>

{% stylesheet %}
  .aster-header-shell {
    position: sticky;
    top: 0;
    z-index: 30;
  }

  .aster-header {
    --icon-stroke-width: 1.35;
    width: 100%;
    min-height: 84px;
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .aster-header__inner,
  .aster-header__menu-topbar {
    width: min(1400px, calc(100% - 40px));
    min-height: 84px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 24px;
  }

  .aster-header a,
  .aster-header button {
    color: inherit;
  }

  .aster-header a {
    text-decoration: none;
  }

  .aster-header__brand {
    justify-self: center;
    min-width: 0;
  }

  .aster-header__brand-link,
  .aster-header__title {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .aster-header__title {
    font-family: var(--font-display--family);
    font-size: 30px;
    line-height: 1;
  }

  .aster-header__logo {
    display: block;
    width: min(var(--aster-logo-width), 30vw);
    aspect-ratio: var(--aster-logo-aspect-ratio);
    background: var(--color-foreground);
    -webkit-mask-image: var(--aster-logo-mask);
    mask-image: var(--aster-logo-mask);
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: contain;
    mask-size: contain;
  }

  .aster-header__utilities {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .aster-header__icon-button,
  .aster-header__account,
  .aster-header__menu-topbar-spacer {
    position: relative;
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
  }

  .aster-header__icon-button {
    border: 0;
    padding: 0;
    background: transparent;
    cursor: pointer;
    transition: opacity var(--aster-duration-interaction, 180ms) ease;
  }

  .aster-header__menu-toggle,
  .aster-header__menu-close {
    justify-self: start;
  }

  .aster-header__icon-button svg,
  .aster-header__account svg {
    width: 20px;
    height: 20px;
  }

  .aster-header__account shopify-account {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .aster-header__cart-count {
    position: absolute;
    top: 4px;
    right: 2px;
    min-width: 18px;
    height: 18px;
    padding-inline: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: var(--color-foreground);
    color: var(--color-background);
    font-size: 10px;
    font-weight: var(--font-body-bolder-weight);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .aster-header__menu-icon {
    position: relative;
    width: 22px;
    height: 16px;
    display: block;
  }

  .aster-header__menu-icon span {
    position: absolute;
    left: 0;
    width: 22px;
    height: 1.5px;
    background: currentColor;
    transform-origin: center;
    transition:
      transform 240ms var(--aster-ease-out, cubic-bezier(0.22, 1, 0.36, 1)),
      top 240ms var(--aster-ease-out, cubic-bezier(0.22, 1, 0.36, 1)),
      opacity 150ms ease;
  }

  .aster-header__menu-icon span:nth-child(1) { top: 1px; }
  .aster-header__menu-icon span:nth-child(2) { top: 7px; }
  .aster-header__menu-icon span:nth-child(3) { top: 13px; }

  .aster-header__menu-toggle[aria-expanded='true'] .aster-header__menu-icon span:nth-child(1),
  .aster-header__menu-dialog.is-visible .aster-header__menu-close .aster-header__menu-icon span:nth-child(1) {
    top: 7px;
    transform: rotate(45deg);
  }

  .aster-header__menu-toggle[aria-expanded='true'] .aster-header__menu-icon span:nth-child(2),
  .aster-header__menu-dialog.is-visible .aster-header__menu-close .aster-header__menu-icon span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0.25);
  }

  .aster-header__menu-toggle[aria-expanded='true'] .aster-header__menu-icon span:nth-child(3),
  .aster-header__menu-dialog.is-visible .aster-header__menu-close .aster-header__menu-icon span:nth-child(3) {
    top: 7px;
    transform: rotate(-45deg);
  }

  .aster-header__menu-dialog {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-background);
    color: var(--color-foreground);
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity 220ms ease,
      transform 260ms var(--aster-ease-out, cubic-bezier(0.22, 1, 0.36, 1));
  }

  .aster-header__menu-dialog[open] {
    display: block;
  }

  .aster-header__menu-dialog.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .aster-header__menu-dialog::backdrop {
    background: transparent;
  }

  .aster-header__menu-overlay {
    min-height: 100dvh;
    display: grid;
    grid-template-rows: auto 1fr auto;
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .aster-header__menu-topbar-spacer {
    justify-self: end;
  }

  .aster-header__menu-content {
    width: min(1400px, calc(100% - 40px));
    margin: 0 auto;
    padding-block: clamp(64px, 9vh, 124px) 56px;
    display: flex;
    align-items: flex-start;
  }

  .aster-header__menu-nav {
    width: min(100%, 760px);
    display: grid;
    gap: clamp(24px, 3vw, 42px);
  }

  .aster-header__menu-group {
    display: grid;
    gap: 14px;
  }

  .aster-header__menu-link {
    width: fit-content;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    font-size: clamp(46px, 6vw, 82px);
    line-height: 0.96;
    letter-spacing: var(--font-heading-letter-spacing);
    text-transform: var(--font-heading-transform);
    opacity: 0.78;
    transition:
      opacity var(--aster-duration-interaction, 180ms) ease,
      transform 220ms var(--aster-ease-out, cubic-bezier(0.22, 1, 0.36, 1));
  }

  .aster-header__menu-children {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
  }

  .aster-header__menu-child,
  .aster-header__menu-footer a {
    width: fit-content;
    font-family: var(--font-navigation--family);
    font-weight: var(--font-navigation-weight);
    text-transform: var(--font-navigation-transform);
    font-size: 13px;
    line-height: 1.3;
    opacity: 0.62;
    transition: opacity var(--aster-duration-interaction, 180ms) ease;
  }

  .aster-header__menu-link.is-active,
  .aster-header__menu-child.is-active {
    opacity: 1;
  }

  .aster-header__menu-empty {
    font-family: var(--font-navigation--family);
    opacity: 0.55;
  }

  .aster-header__menu-footer {
    width: min(1400px, calc(100% - 40px));
    margin: 0 auto;
    padding-bottom: 36px;
    display: flex;
    align-items: center;
    gap: 24px;
  }

  @media (hover: hover) and (pointer: fine) {
    .aster-header__icon-button:hover,
    .aster-header__menu-child:hover,
    .aster-header__menu-footer a:hover {
      opacity: 1;
    }

    .aster-header__menu-link:hover {
      opacity: 1;
      transform: translateX(4px);
    }
  }

  .aster-header a:focus-visible,
  .aster-header button:focus-visible,
  .aster-header shopify-account:focus-visible,
  .aster-header__menu-dialog:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  @media (max-width: 749px) {
    .aster-header {
      min-height: 68px;
    }

    .aster-header__inner,
    .aster-header__menu-topbar {
      width: calc(100% - 30px);
      min-height: 68px;
      gap: 8px;
    }

    .aster-header__logo {
      width: min(var(--aster-logo-width-mobile), 42vw);
    }

    .aster-header__utilities {
      gap: 0;
    }

    .aster-header__account {
      display: none;
    }

    .aster-header__menu-content,
    .aster-header__menu-footer {
      width: calc(100% - 30px);
    }

    .aster-header__menu-content {
      padding-block: clamp(46px, 8vh, 76px) 42px;
    }

    .aster-header__menu-nav {
      gap: 24px;
    }

    .aster-header__menu-link {
      font-size: clamp(40px, 13vw, 62px);
    }

    .aster-header__menu-footer {
      padding-bottom: 28px;
    }
  }

  @media (max-width: 420px) {
    .aster-header__search {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aster-header__icon-button,
    .aster-header__menu-icon span,
    .aster-header__menu-dialog,
    .aster-header__menu-link,
    .aster-header__menu-child,
    .aster-header__menu-footer a {
      transition: none;
    }

    .aster-header__menu-link:hover {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "Customer account menu",
      "default": "customer-account-main-menu"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-2"
    }
  ]
}
{% endschema %}
