{% doc %}
  Renders the global Aster storefront header.

  The existing Skeleton header block is retained as the architectural base,
  but the presentation is Aster-specific: centred logo, restrained desktop
  navigation, utility actions, and a native-details mobile menu with no
  JavaScript dependency.
{% enddoc %}

<header
  class="aster-header full-width color-{{ block.settings.color_scheme }}"
  data-aster-header
  {{ block.shopify_attributes }}
>
  <div class="aster-header__inner">
    <div class="aster-header__mobile-menu">
      <details class="aster-header__drawer" scroll-lock>
        <summary class="aster-header__icon-button" aria-label="Menu">
          <span class="aster-header__menu-icon" aria-hidden="true">
            <span></span>
            <span></span>
          </span>
          <span class="visually-hidden">Menu</span>
        </summary>

        <div class="aster-header__drawer-panel color-{{ block.settings.color_scheme }}">
          <nav class="aster-header__drawer-nav" aria-label="Mobile navigation">
            {% for link in block.settings.menu.links %}
              <div class="aster-header__drawer-group">
                <a
                  class="aster-header__drawer-link{% if link.current %} is-active{% endif %}"
                  href="{{ link.url }}"
                  {% if link.current %}aria-current="page"{% endif %}
                >
                  {{ link.title | escape }}
                </a>

                {% if link.links != blank %}
                  <div class="aster-header__drawer-children">
                    {% for child_link in link.links %}
                      <a
                        class="aster-header__drawer-child{% if child_link.current %} is-active{% endif %}"
                        href="{{ child_link.url }}"
                        {% if child_link.current %}aria-current="page"{% endif %}
                      >
                        {{ child_link.title | escape }}
                      </a>
                    {% endfor %}
                  </div>
                {% endif %}
              </div>
            {% endfor %}
          </nav>

          <div class="aster-header__drawer-utilities">
            <a href="{{ routes.search_url }}">Search</a>
            {% if shop.customer_accounts_enabled %}
              <a href="{{ routes.account_url }}">Account</a>
            {% endif %}
          </div>
        </div>
      </details>
    </div>

    <nav class="aster-header__nav" aria-label="Main navigation">
      {% for link in block.settings.menu.links %}
        <a
          class="aster-header__nav-link{% if link.current %} is-active{% endif %}"
          href="{{ link.url }}"
          {% if link.current %}aria-current="page"{% endif %}
        >
          {{ link.title | escape }}
        </a>
      {% endfor %}
    </nav>

    <div class="aster-header__brand">
      {% if settings.logo != blank %}
        <a class="aster-header__brand-link" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
          <span
            class="aster-header__logo"
            aria-hidden="true"
            style="--aster-logo-width: {{ settings.logo_width }}px; --aster-logo-width-mobile: {{ settings.logo_mobile_width }}px; --aster-logo-aspect-ratio: {{ settings.logo.aspect_ratio | default: 3 }}; --aster-logo-mask: url('{{ settings.logo | image_url: width: 1200 }}');"
          ></span>
        </a>
      {% else %}
        <a class="aster-header__title" href="{{ routes.root_url }}">{{ shop.name | escape }}</a>
      {% endif %}
    </div>

    <div class="aster-header__utilities">
      <a class="aster-header__icon-button aster-header__search" href="{{ routes.search_url }}" aria-label="Search">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
          <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.4"></circle>
          <path d="m16 16 4.25 4.25" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
        </svg>
      </a>

      {% if shop.customer_accounts_enabled %}
        <span class="aster-header__account" aria-label="Account">
          <shopify-account menu="{{ block.settings.customer_account_menu }}">
            {{ 'icon-account.svg' | inline_asset_content }}
          </shopify-account>
        </span>
      {% endif %}

      <a class="aster-header__icon-button aster-header__cart" href="{{ routes.cart_url }}" aria-label="Cart{% if cart.item_count > 0 %}, {{ cart.item_count }} items{% endif %}">
        {{ 'icon-cart.svg' | inline_asset_content }}
        {% if cart.item_count > 0 %}
          <span class="aster-header__cart-count" aria-hidden="true">{{ cart.item_count }}</span>
        {% endif %}
      </a>
    </div>
  </div>
</header>

{% stylesheet %}
  .aster-header-shell {
    position: sticky;
    top: 0;
    z-index: 30;
  }

  .aster-header {
    --icon-stroke-width: 1.35;
    width: 100%;
    height: auto;
    min-height: 84px;
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .aster-header__inner {
    width: min(1400px, calc(100% - 40px));
    min-height: 84px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 24px;
  }

  .aster-header a,
  .aster-header summary {
    color: inherit;
  }

  .aster-header a {
    text-decoration: none;
  }

  .aster-header__nav {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: clamp(18px, 2vw, 34px);
    font-family: var(--font-navigation--family);
    font-weight: var(--font-navigation-weight);
    text-transform: var(--font-navigation-transform);
  }

  .aster-header__nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    white-space: nowrap;
    font-size: 13px;
    line-height: 1;
    opacity: 0.82;
    transition: opacity var(--aster-duration-interaction, 180ms) ease;
  }

  .aster-header__nav-link.is-active {
    opacity: 1;
  }

  .aster-header__brand {
    justify-self: center;
    min-width: 0;
  }

  .aster-header__brand-link,
  .aster-header__title {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .aster-header__title {
    font-family: var(--font-display--family);
    font-size: 30px;
    line-height: 1;
  }

  .aster-header__logo {
    display: block;
    width: min(var(--aster-logo-width), 30vw);
    aspect-ratio: var(--aster-logo-aspect-ratio);
    background: var(--color-foreground);
    -webkit-mask-image: var(--aster-logo-mask);
    mask-image: var(--aster-logo-mask);
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: contain;
    mask-size: contain;
  }

  .aster-header__utilities {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .aster-header__icon-button,
  .aster-header__account {
    position: relative;
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
  }

  .aster-header__icon-button {
    border: 0;
    background: transparent;
    cursor: pointer;
    transition: opacity var(--aster-duration-interaction, 180ms) ease;
  }

  .aster-header__icon-button svg,
  .aster-header__account svg {
    width: 20px;
    height: 20px;
  }

  .aster-header__account shopify-account {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .aster-header__cart-count {
    position: absolute;
    top: 4px;
    right: 2px;
    min-width: 18px;
    height: 18px;
    padding-inline: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: var(--color-foreground);
    color: var(--color-background);
    font-size: 10px;
    font-weight: var(--font-body-bolder-weight);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .aster-header__mobile-menu {
    display: none;
  }

  .aster-header__drawer > summary {
    list-style: none;
  }

  .aster-header__drawer > summary::-webkit-details-marker {
    display: none;
  }

  .aster-header__menu-icon {
    position: relative;
    width: 20px;
    height: 14px;
    display: block;
  }

  .aster-header__menu-icon span {
    position: absolute;
    left: 0;
    width: 20px;
    height: 1.5px;
    background: currentColor;
    transform-origin: center;
    transition: transform var(--aster-duration-interaction, 180ms) var(--aster-ease-out, ease), top var(--aster-duration-interaction, 180ms) var(--aster-ease-out, ease);
  }

  .aster-header__menu-icon span:first-child {
    top: 3px;
  }

  .aster-header__menu-icon span:last-child {
    top: 10px;
  }

  .aster-header__drawer[open] .aster-header__menu-icon span:first-child {
    top: 6px;
    transform: rotate(45deg);
  }

  .aster-header__drawer[open] .aster-header__menu-icon span:last-child {
    top: 6px;
    transform: rotate(-45deg);
  }

  .aster-header__drawer-panel {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    max-height: calc(100dvh - 68px);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 36px 15px 44px;
    background: var(--color-background);
    color: var(--color-foreground);
    animation: aster-header-drawer-in var(--aster-duration-reveal, 520ms) var(--aster-ease-out, ease) both;
  }

  .aster-header__drawer-nav {
    width: min(100%, 680px);
    margin: 0 auto;
    display: grid;
    gap: 24px;
  }

  .aster-header__drawer-group {
    display: grid;
    gap: 11px;
  }

  .aster-header__drawer-link {
    width: fit-content;
    font-family: var(--font-heading--family);
    font-size: clamp(30px, 9vw, 44px);
    line-height: 1;
    opacity: 0.82;
  }

  .aster-header__drawer-link.is-active,
  .aster-header__drawer-child.is-active {
    opacity: 1;
  }

  .aster-header__drawer-children {
    display: grid;
    gap: 8px;
    padding-left: 2px;
  }

  .aster-header__drawer-child,
  .aster-header__drawer-utilities a {
    width: fit-content;
    font-family: var(--font-navigation--family);
    font-weight: var(--font-navigation-weight);
    text-transform: var(--font-navigation-transform);
    opacity: 0.68;
  }

  .aster-header__drawer-utilities {
    width: min(100%, 680px);
    margin: 42px auto 0;
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
  }

  @keyframes aster-header-drawer-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .aster-header__nav-link:hover,
    .aster-header__icon-button:hover,
    .aster-header__drawer a:hover {
      opacity: 1;
    }
  }

  .aster-header a:focus-visible,
  .aster-header summary:focus-visible,
  .aster-header shopify-account:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  @media (max-width: 989px) {
    .aster-header {
      min-height: 68px;
    }

    .aster-header__inner {
      width: calc(100% - 30px);
      min-height: 68px;
      grid-template-columns: 1fr auto 1fr;
      gap: 8px;
    }

    .aster-header__nav {
      display: none;
    }

    .aster-header__mobile-menu {
      display: block;
      justify-self: start;
    }

    .aster-header__brand {
      grid-column: 2;
    }

    .aster-header__logo {
      width: min(var(--aster-logo-width-mobile), 42vw);
    }

    .aster-header__utilities {
      grid-column: 3;
      justify-self: end;
      gap: 0;
    }

    .aster-header__account {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .aster-header__search {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aster-header__nav-link,
    .aster-header__icon-button,
    .aster-header__menu-icon span {
      transition: none;
    }

    .aster-header__drawer-panel {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "Customer account menu",
      "default": "customer-account-main-menu"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-2"
    }
  ]
}
{% endschema %}
