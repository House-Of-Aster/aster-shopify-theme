{% comment %}ASTER cinematic password layout V2{% endcomment %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#a52d34">
    <title>ASTER</title>

    {% render 'css-variables' %}
    {% render 'color-schemes' %}

    {% if settings.favicon != blank %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32, crop: 'center' }}" sizes="32x32">
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 16, height: 16, crop: 'center' }}" sizes="16x16">
      <link rel="shortcut icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32, crop: 'center' }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180, crop: 'center' }}" sizes="180x180">
    {% endif %}

    {{ content_for_header }}

    <style>
      html,
      body {
        width: 100%;
        min-height: 100%;
        margin: 0;
        padding: 0;
        overflow: hidden;
        background: #a52d34;
      }

      body {
        font-family: var(--font-body--family, Arial, sans-serif);
      }

      main {
        width: 100%;
        min-height: 100vh;
        min-height: 100svh;
        min-height: 100dvh;
        margin: 0;
        padding: 0;
      }

      /*
        ASTER presentation layer for the Klaviyo waitlist embed.
        Klaviyo continues to own the real inputs, validation and submission.
        These overrides only control its appearance inside the cinematic password page.
      */
      .aster-cinematic-password__signup form,
      .aster-cinematic-password__signup .klaviyo-form {
        width: 100% !important;
        max-width: none !important;
        margin: 0 !important;
        padding: 0 !important;
        border: 0 !important;
        background: transparent !important;
        box-shadow: none !important;
      }

      .aster-cinematic-password__signup form div,
      .aster-cinematic-password__signup form section {
        background-color: transparent !important;
        box-shadow: none !important;
      }

      .aster-cinematic-password__signup form label {
        display: none !important;
      }

      .aster-cinematic-password__signup form input:not([type='hidden']):not([type='checkbox']):not([type='radio']),
      .aster-cinematic-password__signup form textarea,
      .aster-cinematic-password__signup form select {
        width: 100% !important;
        min-width: 0 !important;
        min-height: 48px !important;
        margin: 0 !important;
        padding: 0 16px !important;
        border: 1px solid rgba(248, 246, 235, .58) !important;
        border-radius: 0 !important;
        color: #f8f6eb !important;
        font-family: var(--font-body--family, Arial, sans-serif) !important;
        font-size: 11px !important;
        font-style: normal !important;
        font-weight: 400 !important;
        line-height: 1 !important;
        letter-spacing: .11em !important;
        background: rgba(43, 8, 13, .22) !important;
        box-shadow: none !important;
        outline: 0 !important;
        -webkit-appearance: none !important;
        appearance: none !important;
      }

      .aster-cinematic-password__signup form input:not([type='hidden']):not([type='checkbox']):not([type='radio']):focus,
      .aster-cinematic-password__signup form textarea:focus,
      .aster-cinematic-password__signup form select:focus {
        border-color: rgba(248, 246, 235, .96) !important;
        background: rgba(43, 8, 13, .34) !important;
        box-shadow: 0 0 0 1px rgba(248, 246, 235, .14) !important;
      }

      .aster-cinematic-password__signup form input::placeholder,
      .aster-cinematic-password__signup form textarea::placeholder {
        color: rgba(248, 246, 235, .72) !important;
        font-size: 10px !important;
        letter-spacing: .16em !important;
        text-transform: uppercase !important;
        opacity: 1 !important;
      }

      .aster-cinematic-password__signup form button,
      .aster-cinematic-password__signup form button[type='submit'] {
        width: 100% !important;
        min-height: 48px !important;
        margin: 0 !important;
        padding: 0 18px !important;
        border: 1px solid #f8f6eb !important;
        border-radius: 0 !important;
        color: #42131c !important;
        font-family: var(--font-body--family, Arial, sans-serif) !important;
        font-size: 10px !important;
        font-style: normal !important;
        font-weight: 500 !important;
        line-height: 1 !important;
        letter-spacing: .22em !important;
        text-transform: uppercase !important;
        background: #f8f6eb !important;
        box-shadow: none !important;
        cursor: pointer !important;
        transition: background-color 180ms ease, color 180ms ease, opacity 180ms ease !important;
      }

      .aster-cinematic-password__signup form button:hover,
      .aster-cinematic-password__signup form button:focus-visible {
        color: #f8f6eb !important;
        background: transparent !important;
      }

      .aster-cinematic-password__signup form p,
      .aster-cinematic-password__signup form p *,
      .aster-cinematic-password__signup form small,
      .aster-cinematic-password__signup form small *,
      .aster-cinematic-password__signup form [class*='RichText'],
      .aster-cinematic-password__signup form [class*='rich-text'] {
        color: rgba(248, 246, 235, .58) !important;
        font-family: var(--font-body--family, Arial, sans-serif) !important;
        font-size: 8px !important;
        font-style: normal !important;
        font-weight: 400 !important;
        line-height: 1.45 !important;
        letter-spacing: .035em !important;
        text-align: center !important;
      }

      .aster-cinematic-password__signup form a,
      .aster-cinematic-password__signup form a:visited {
        color: rgba(248, 246, 235, .86) !important;
        text-decoration-color: rgba(248, 246, 235, .48) !important;
        text-underline-offset: 2px !important;
      }

      .aster-cinematic-password__signup form [style*='display: flex'],
      .aster-cinematic-password__signup form [style*='display:flex'] {
        gap: 8px !important;
      }

      .aster-cinematic-password__signup form div:has(> input:not([type='hidden']):not([type='checkbox']):not([type='radio'])),
      .aster-cinematic-password__signup form div:has(> textarea),
      .aster-cinematic-password__signup form div:has(> select),
      .aster-cinematic-password__signup form div:has(> button) {
        padding-top: 0 !important;
        padding-bottom: 8px !important;
      }

      .aster-cinematic-password__signup form [aria-live='polite'],
      .aster-cinematic-password__signup form [role='alert'] {
        color: #f8f6eb !important;
        font-family: var(--font-body--family, Arial, sans-serif) !important;
        font-size: 9px !important;
        line-height: 1.4 !important;
      }

      @media screen and (max-width: 749px) {
        .aster-cinematic-password__signup form input:not([type='hidden']):not([type='checkbox']):not([type='radio']),
        .aster-cinematic-password__signup form textarea,
        .aster-cinematic-password__signup form select,
        .aster-cinematic-password__signup form button,
        .aster-cinematic-password__signup form button[type='submit'] {
          min-height: 44px !important;
        }

        .aster-cinematic-password__signup form input:not([type='hidden']):not([type='checkbox']):not([type='radio']),
        .aster-cinematic-password__signup form textarea,
        .aster-cinematic-password__signup form select {
          padding-right: 13px !important;
          padding-left: 13px !important;
        }

        .aster-cinematic-password__signup form p,
        .aster-cinematic-password__signup form p *,
        .aster-cinematic-password__signup form small,
        .aster-cinematic-password__signup form small * {
          font-size: 7px !important;
          line-height: 1.4 !important;
        }
      }
    </style>
  </head>
  <body>
    <main id="AsterPasswordPage">
      {{ content_for_layout }}
    </main>

    <script>
      (() => {
        const page = document.getElementById('AsterPasswordPage');
        if (!page) return;

        const refineKlaviyoForm = () => {
          const signup = page.querySelector('.aster-cinematic-password__signup');
          if (!signup) return;

          const form = signup.querySelector('form');
          if (!form) return;

          const visibleInputs = Array.from(
            form.querySelectorAll("input:not([type='hidden']):not([type='checkbox']):not([type='radio'])")
          );

          const emailInput = form.querySelector("input[type='email']") || visibleInputs.find((input) => /email/i.test(input.name || ''));
          const nameInputs = visibleInputs.filter((input) => input !== emailInput);

          if (nameInputs[0] && nameInputs[0].getAttribute('placeholder') !== 'FIRST NAME') {
            nameInputs[0].setAttribute('placeholder', 'FIRST NAME');
          }
          if (nameInputs[1] && nameInputs[1].getAttribute('placeholder') !== 'LAST NAME') {
            nameInputs[1].setAttribute('placeholder', 'LAST NAME');
          }
          if (emailInput && emailInput.getAttribute('placeholder') !== 'YOUR EMAIL ADDRESS') {
            emailInput.setAttribute('placeholder', 'YOUR EMAIL ADDRESS');
          }

          form.querySelectorAll('button').forEach((button) => {
            const buttonText = (button.textContent || '').trim();
            const isSubmit = (button.type || '').toLowerCase() === 'submit' || /join|submit|sign|waitlist/i.test(buttonText);

            if (isSubmit && buttonText !== "I'M IN.") {
              button.textContent = "I'M IN.";
              button.setAttribute('aria-label', "I'm in");
            }
          });
        };

        refineKlaviyoForm();

        const observer = new MutationObserver(() => refineKlaviyoForm());
        observer.observe(page, { childList: true, subtree: true });
      })();
    </script>
  </body>
</html>
