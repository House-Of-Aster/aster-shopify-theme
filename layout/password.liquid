<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#6b2331">
    <title>ASTER</title>

    {% if settings.favicon != blank %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32, crop: 'center' }}" sizes="32x32">
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 16, height: 16, crop: 'center' }}" sizes="16x16">
      <link rel="shortcut icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32, crop: 'center' }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180, crop: 'center' }}" sizes="180x180">
    {% endif %}

    {{ content_for_header }}
    <style>
      @font-face {
        font-family: "British Poems";
        src: url("{{ 'BritishPoems-Regular.woff2' | asset_url }}") format("woff2");
        font-style: normal;
        font-weight: 400;
        font-display: swap;
      }

      html,
      body {
        width: 100%;
        min-height: 100%;
        margin: 0;
        padding: 0;
        background: #6b2331;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      main {
        width: 100%;
        min-height: 100vh;
        margin: 0;
        padding: 0;
      }

      #AsterPasswordPage .aster-landing__heading {
        font-family: "British Poems", serif !important;
        font-weight: 400 !important;
      }

      @media screen and (max-width: 749px) {
        #AsterPasswordPage .aster-landing__logo-wrap {
          overflow: visible !important;
        }
      }
    </style>
  </head>
  <body>
    <main id="AsterPasswordPage">
      {{ content_for_layout }}
    </main>
  </body>
</html>
