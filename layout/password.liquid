<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#a52d34">
    <title>ASTER</title>

    {% render 'css-variables' %}
    {% render 'color-schemes' %}
    {{ 'aster-password-motion.css' | asset_url | stylesheet_tag }}

    {% if settings.favicon != blank %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32, crop: 'center' }}" sizes="32x32">
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 16, height: 16, crop: 'center' }}" sizes="16x16">
      <link rel="shortcut icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32, crop: 'center' }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180, crop: 'center' }}" sizes="180x180">
    {% endif %}

    {{ content_for_header }}
    <script type="application/json" id="AsterPasswordStainSources">
      [
        {{ 'Stain-1.webp' | file_url | json }},
        {{ 'Stain-2.webp' | file_url | json }},
        {{ 'Stain-3.webp' | file_url | json }},
        {{ 'Stain-4.webp' | file_url | json }},
        {{ 'Stain-5.webp' | file_url | json }},
        {{ 'Stain-6.webp' | file_url | json }},
        {{ 'Stain-7.webp' | file_url | json }},
        {{ 'Stain-8.webp' | file_url | json }}
      ]
    </script>
    <script src="{{ 'aster-password-motion.js' | asset_url }}" defer></script>
    <style>
      html,
      body {
        width: 100%;
        min-height: 100%;
        margin: 0;
        padding: 0;
        background: #a52d34;
      }

      #AsterPasswordPage [data-aster-landing] .aster-landing__intro-overlay {
        background: #a52d34 !important;
      }

      #AsterPasswordPage h1,
      #AsterPasswordPage h2,
      #AsterPasswordPage h3,
      #AsterPasswordPage h4,
      #AsterPasswordPage h5,
      #AsterPasswordPage h6,
      #AsterPasswordPage .aster-landing__heading {
        font-family: "British Poems", serif !important;
        font-style: normal !important;
        font-weight: 400 !important;
      }

      main {
        width: 100%;
        min-height: 100vh;
        margin: 0;
        padding: 0;
      }

      @media screen and (max-width: 749px) {
        #AsterPasswordPage .aster-landing__logo-wrap {
          overflow: visible !important;
        }
      }
    </style>
  </head>
  <body>
    <main id="AsterPasswordPage">
      {{ content_for_layout }}
    </main>
  </body>
</html>
