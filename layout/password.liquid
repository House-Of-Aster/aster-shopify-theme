<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#6b2331">
    <title>ASTER</title>

    {% if settings.favicon != blank %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32, crop: 'center' }}" sizes="32x32">
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 16, height: 16, crop: 'center' }}" sizes="16x16">
      <link rel="shortcut icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32, crop: 'center' }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180, crop: 'center' }}" sizes="180x180">
    {% endif %}

    {{ content_for_header }}
    <style>
      html,
      body {
        width: 100%;
        min-height: 100%;
        margin: 0;
        padding: 0;
        background: #6b2331;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      main {
        width: 100%;
        min-height: 100vh;
        margin: 0;
        padding: 0;
      }

      {% if settings.aster_bear_image != blank %}
        #AsterPasswordPage [data-aster-landing]::before {
          content: "";
          position: absolute;
          inset: 0;
          z-index: 2;
          pointer-events: none;
          background-image: url('{{ settings.aster_bear_image | image_url: width: 2000 }}');
          background-repeat: no-repeat;
          background-position: {{ settings.aster_bear_x_desktop }}% {{ settings.aster_bear_y_desktop }}%;
          background-size: {{ settings.aster_bear_scale_desktop }}vw auto;
        }

        @media screen and (max-width: 749px) {
          #AsterPasswordPage [data-aster-landing]::before {
            background-position: {{ settings.aster_bear_x_mobile }}% {{ settings.aster_bear_y_mobile }}%;
            background-size: {{ settings.aster_bear_scale_mobile }}vw auto;
          }
        }
      {% endif %}
    </style>
  </head>
  <body>
    <main id="AsterPasswordPage">
      {{ content_for_layout }}
    </main>
  </body>
</html>
