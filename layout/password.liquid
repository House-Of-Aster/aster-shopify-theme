{% comment %}ASTER cinematic password layout V2{% endcomment %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#a52d34">
    <title>ASTER</title>

    {% render 'css-variables' %}
    {% render 'color-schemes' %}

    {% if settings.favicon != blank %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32, crop: 'center' }}" sizes="32x32">
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 16, height: 16, crop: 'center' }}" sizes="16x16">
      <link rel="shortcut icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32, crop: 'center' }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180, crop: 'center' }}" sizes="180x180">
    {% endif %}

    {{ content_for_header }}

    <style>
      html,
      body {
        width: 100%;
        min-height: 100%;
        margin: 0;
        padding: 0;
        overflow: hidden;
        background: #a52d34;
      }

      body {
        font-family: var(--font-body--family, Arial, sans-serif);
      }

      main {
        width: 100%;
        min-height: 100vh;
        min-height: 100svh;
        min-height: 100dvh;
        margin: 0;
        padding: 0;
      }

      /*
        ASTER visual layer for the real Klaviyo waitlist form.
        This intentionally uses CSS only so Klaviyo keeps full ownership of rendering,
        validation and submission behaviour.
      */
      .aster-cinematic-password__signup .klaviyo-form,
      .aster-cinematic-password__signup form[data-testid^='klaviyo-form-'] {
        width: 100% !important;
        max-width: none !important;
        margin: 0 !important;
        padding: 0 !important;
        border: 0 !important;
        border-radius: 0 !important;
        background: transparent !important;
        box-shadow: none !important;
        overflow: visible !important;
      }

      .aster-cinematic-password__signup form[data-testid^='klaviyo-form-'] > div:first-of-type {
        display: grid !important;
        grid-template-columns: repeat(6, minmax(0, 1fr)) !important;
        grid-template-rows: auto auto auto !important;
        gap: 10px 6px !important;
        width: 100% !important;
        min-height: 0 !important;
        margin: 0 !important;
        padding: 0 !important;
        justify-content: stretch !important;
        background: transparent !important;
      }

      .aster-cinematic-password__signup form[data-testid^='klaviyo-form-'] > div:first-of-type > [data-testid='form-row'] {
        display: block !important;
        min-width: 0 !important;
        margin: 0 !important;
        padding: 0 !important;
        background: transparent !important;
      }

      .aster-cinematic-password__signup form[data-testid^='klaviyo-form-'] > div:first-of-type > [data-testid='form-row']:nth-of-type(1) {
        grid-column: 1 / span 3;
        grid-row: 1;
      }

      .aster-cinematic-password__signup form[data-testid^='klaviyo-form-'] > div:first-of-type > [data-testid='form-row']:nth-of-type(2) {
        grid-column: 4 / span 3;
        grid-row: 1;
      }

      .aster-cinematic-password__signup form[data-testid^='klaviyo-form-'] > div:first-of-type > [data-testid='form-row']:nth-of-type(3) {
        grid-column: 1 / span 4;
        grid-row: 2;
      }

      .aster-cinematic-password__signup form[data-testid^='klaviyo-form-'] > div:first-of-type > [data-testid='form-row']:nth-of-type(4) {
        grid-column: 1 / -1;
        grid-row: 3;
      }

      .aster-cinematic-password__signup form[data-testid^='klaviyo-form-'] > div:first-of-type > [data-testid='form-row']:nth-of-type(5) {
        grid-column: 5 / span 2;
        grid-row: 2;
      }

      .aster-cinematic-password__signup [data-testid='form-component'],
      .aster-cinematic-password__signup .klaviyo-textinput,
      .aster-cinematic-password__signup .klaviyo-emailinput {
        position: relative !important;
        width: 100% !important;
        max-width: none !important;
        min-width: 0 !important;
        margin: 0 !important;
        padding: 0 !important;
        background: transparent !important;
      }

      .aster-cinematic-password__signup .klaviyo-textinput label,
      .aster-cinematic-password__signup .klaviyo-emailinput label {
        position: absolute !important;
        z-index: 2 !important;
        top: 50% !important;
        left: 18px !important;
        display: block !important;
        width: auto !important;
        height: auto !important;
        margin: 0 !important;
        padding: 0 !important;
        clip: auto !important;
        overflow: visible !important;
        white-space: nowrap !important;
        transform: translateY(-50%) !important;
        pointer-events: none !important;
        color: #f8f6eb !important;
        font-family: var(--font-body--family, Arial, sans-serif) !important;
        font-size: 10px !important;
        font-style: normal !important;
        font-weight: 400 !important;
        line-height: 1 !important;
        letter-spacing: .08em !important;
        text-transform: uppercase !important;
        opacity: 1 !important;
        transition: opacity 120ms ease !important;
      }

      .aster-cinematic-password__signup .klaviyo-emailinput label {
        font-size: 0 !important;
      }

      .aster-cinematic-password__signup .klaviyo-emailinput label::after {
        content: 'YOUR EMAIL ADDRESS';
        font-size: 10px;
      }

      .aster-cinematic-password__signup .klaviyo-textinput:focus-within label,
      .aster-cinematic-password__signup .klaviyo-emailinput:focus-within label,
      .aster-cinematic-password__signup .klaviyo-textinput:has(input:not(:placeholder-shown)) label,
      .aster-cinematic-password__signup .klaviyo-emailinput:has(input:not(:placeholder-shown)) label {
        opacity: 0 !important;
      }

      .aster-cinematic-password__signup input[autocomplete='given-name'],
      .aster-cinematic-password__signup input[autocomplete='family-name'],
      .aster-cinematic-password__signup input[type='email'] {
        width: 100% !important;
        min-width: 0 !important;
        height: 50px !important;
        min-height: 50px !important;
        margin: 0 !important;
        padding: 0 18px !important;
        border: 1px solid rgba(248, 246, 235, .88) !important;
        border-radius: 0 !important;
        color: #f8f6eb !important;
        caret-color: #f8f6eb !important;
        font-family: var(--font-body--family, Arial, sans-serif) !important;
        font-size: 11px !important;
        font-style: normal !important;
        font-weight: 400 !important;
        line-height: 1 !important;
        letter-spacing: .04em !important;
        background: rgba(38, 5, 9, .22) !important;
        box-shadow: none !important;
        outline: 0 !important;
        appearance: none !important;
        -webkit-appearance: none !important;
        transition: border-color 140ms ease, background-color 140ms ease !important;
      }

      .aster-cinematic-password__signup input[autocomplete='given-name']::placeholder,
      .aster-cinematic-password__signup input[autocomplete='family-name']::placeholder,
      .aster-cinematic-password__signup input[type='email']::placeholder {
        color: transparent !important;
        opacity: 0 !important;
      }

      .aster-cinematic-password__signup input[autocomplete='given-name']:focus,
      .aster-cinematic-password__signup input[autocomplete='family-name']:focus,
      .aster-cinematic-password__signup input[type='email']:focus {
        border-color: #f8f6eb !important;
        background: rgba(38, 5, 9, .34) !important;
      }

      .aster-cinematic-password__signup .klaviyo-form-button {
        position: relative !important;
        width: 100% !important;
        min-width: 0 !important;
        height: 50px !important;
        min-height: 50px !important;
        margin: 0 !important;
        padding: 0 16px !important;
        border: 1px solid #f8f6eb !important;
        border-radius: 0 !important;
        color: transparent !important;
        font-size: 0 !important;
        line-height: 1 !important;
        background: #f8f6eb !important;
        box-shadow: none !important;
        cursor: pointer !important;
        transition: background-color 160ms ease, border-color 160ms ease !important;
      }

      .aster-cinematic-password__signup .klaviyo-form-button::before {
        content: "I'M IN.";
        display: block;
        color: #351017;
        font-family: var(--font-body--family, Arial, sans-serif);
        font-size: 10px;
        font-style: normal;
        font-weight: 400;
        line-height: 48px;
        letter-spacing: .08em;
        text-align: center;
        text-transform: uppercase;
      }

      .aster-cinematic-password__signup .klaviyo-form-button:hover,
      .aster-cinematic-password__signup .klaviyo-form-button:focus-visible {
        border-color: #f8f6eb !important;
        background: #f8f6eb !important;
      }

      .aster-cinematic-password__signup .klaviyo-form-richtext,
      .aster-cinematic-password__signup .klaviyo-form-richtext p,
      .aster-cinematic-password__signup .klaviyo-form-richtext span {
        width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        color: rgba(248, 246, 235, .58) !important;
        font-family: var(--font-body--family, Arial, sans-serif) !important;
        font-size: 8px !important;
        font-style: normal !important;
        font-weight: 400 !important;
        line-height: 1.45 !important;
        letter-spacing: .015em !important;
        text-align: center !important;
        background: transparent !important;
      }

      .aster-cinematic-password__signup .klaviyo-form-richtext a,
      .aster-cinematic-password__signup .klaviyo-form-richtext a span {
        color: rgba(248, 246, 235, .82) !important;
        text-decoration-color: rgba(248, 246, 235, .42) !important;
        text-underline-offset: 2px !important;
      }

      .aster-cinematic-password__signup form[data-testid^='klaviyo-form-'] [role='alert'],
      .aster-cinematic-password__signup form[data-testid^='klaviyo-form-'] [aria-invalid='true'] + div {
        color: #f8f6eb !important;
        font-family: var(--font-body--family, Arial, sans-serif) !important;
        font-size: 8px !important;
        line-height: 1.35 !important;
      }

      @media screen and (max-width: 749px) {
        .aster-cinematic-password__signup form[data-testid^='klaviyo-form-'] > div:first-of-type {
          grid-template-columns: 1fr !important;
          grid-template-rows: auto !important;
          gap: 7px !important;
        }

        .aster-cinematic-password__signup form[data-testid^='klaviyo-form-'] > div:first-of-type > [data-testid='form-row']:nth-of-type(1),
        .aster-cinematic-password__signup form[data-testid^='klaviyo-form-'] > div:first-of-type > [data-testid='form-row']:nth-of-type(2),
        .aster-cinematic-password__signup form[data-testid^='klaviyo-form-'] > div:first-of-type > [data-testid='form-row']:nth-of-type(3),
        .aster-cinematic-password__signup form[data-testid^='klaviyo-form-'] > div:first-of-type > [data-testid='form-row']:nth-of-type(4),
        .aster-cinematic-password__signup form[data-testid^='klaviyo-form-'] > div:first-of-type > [data-testid='form-row']:nth-of-type(5) {
          grid-column: 1 !important;
          grid-row: auto !important;
        }

        .aster-cinematic-password__signup form[data-testid^='klaviyo-form-'] > div:first-of-type > [data-testid='form-row']:nth-of-type(1) { order: 1; }
        .aster-cinematic-password__signup form[data-testid^='klaviyo-form-'] > div:first-of-type > [data-testid='form-row']:nth-of-type(2) { order: 2; }
        .aster-cinematic-password__signup form[data-testid^='klaviyo-form-'] > div:first-of-type > [data-testid='form-row']:nth-of-type(3) { order: 3; }
        .aster-cinematic-password__signup form[data-testid^='klaviyo-form-'] > div:first-of-type > [data-testid='form-row']:nth-of-type(5) { order: 4; }
        .aster-cinematic-password__signup form[data-testid^='klaviyo-form-'] > div:first-of-type > [data-testid='form-row']:nth-of-type(4) { order: 5; }

        .aster-cinematic-password__signup input[autocomplete='given-name'],
        .aster-cinematic-password__signup input[autocomplete='family-name'],
        .aster-cinematic-password__signup input[type='email'],
        .aster-cinematic-password__signup .klaviyo-form-button {
          height: 44px !important;
          min-height: 44px !important;
        }

        .aster-cinematic-password__signup .klaviyo-form-button::before {
          line-height: 42px;
        }

        .aster-cinematic-password__signup .klaviyo-form-richtext,
        .aster-cinematic-password__signup .klaviyo-form-richtext p,
        .aster-cinematic-password__signup .klaviyo-form-richtext span {
          font-size: 7.5px !important;
          line-height: 1.4 !important;
        }
      }
    </style>
  </head>
  <body>
    <main id="AsterPasswordPage">
      {{ content_for_layout }}
    </main>
  </body>
</html>
