{% block 'container' %}
  <div class="product-images">
    {% for image in product.images %}
      {% render 'image',
        class: 'product-image',
        image: image,
        width: 1600,
        sizes: '(min-width: 750px) 50vw, 100vw',
        priority: forloop.first
      %}
    {% endfor %}
  </div>

  <div class="product-info">
    <h1>{{ product.title }}</h1>
    <p>{{ product.price | money }}</p>
    <p>{{ product.description }}</p>
  </div>

  <div class="product-form">
    {% form 'product', product, class: 'form-stack' %}
      {% assign current_variant = product.selected_or_first_available_variant %}

      <div class="field">
        <label class="field__label" for="AsterVariantSelect">Variant</label>
        <select id="AsterVariantSelect" name="id">
          {% for variant in product.variants %}
            <option
              value="{{ variant.id }}"
              {% if variant == current_variant %}
                selected="selected"
              {% endif %}
            >
              {{ variant.title }} - {{ variant.price | money }}
            </option>
          {% endfor %}
        </select>
      </div>

      <div class="field">
        <label class="field__label" for="AsterQuantityInput">Quantity</label>
        <input id="AsterQuantityInput" type="number" name="quantity" min="1" step="1" value="1" inputmode="numeric">
      </div>

      <input class="button button--primary" type="submit" value="Add to cart">
      {{ form | payment_button }}
    {% endform %}
  </div>
{% endblock %}
