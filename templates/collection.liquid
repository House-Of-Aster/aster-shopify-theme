{{ 'aster-product-card.css' | asset_url | stylesheet_tag }}
<script src="{{ 'aster-product-card.js' | asset_url }}" defer></script>

{% block 'container' %}
  <h1>{{ collection.title }}</h1>

  {% paginate collection.products by 20 %}
    <div class="collection-products" data-aster-product-grid>
      {% for product in collection.products %}
        {% render 'aster-product-card', product: product %}
      {% endfor %}
    </div>

    {{ paginate | default_pagination }}
  {% endpaginate %}
{% endblock %}
