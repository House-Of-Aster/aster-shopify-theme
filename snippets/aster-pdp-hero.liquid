{% comment %}
  Shared Aster PDP hero / buy area.
  Reused by Planner and future accessory / supplement PDP templates.
{% endcomment %}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign hero_image = current_variant.featured_image | default: product.featured_image
  assign pdp_eyebrow = product.metafields.aster.pdp_eyebrow.value | default: product.product_type
  assign pdp_intro = product.metafields.aster.pdp_intro.value | default: product.metafields.aster.card_description.value
  assign pdp_sections = product.metafields.aster.pdp_sections.value
  assign highlight_section = nil
  assign colour_option = nil
  assign colour_option_index = nil

  for pdp_section in pdp_sections
    assign section_type = pdp_section.section_type.value | downcase | strip
    if section_type == 'highlights'
      assign highlight_section = pdp_section
      break
    endif
  endfor

  for option in product.options_with_values
    assign option_name_downcase = option.name | downcase
    if option_name_downcase == 'colour' or option_name_downcase == 'color'
      assign colour_option = option
      assign colour_option_index = forloop.index0
      break
    endif
  endfor

  assign thumbnail_count = product.images.size
  if thumbnail_count > 6
    assign thumbnail_count = 6
  endif
%}

<section class="aster-pdp__hero" data-aster-pdp data-product-url="{{ product.url }}">
  <div class="aster-pdp__media-shell" data-aster-reveal="media">
    {% if product.images.size > 1 %}
      <div class="aster-pdp__thumbnail-rail" style="--aster-pdp-thumbnail-count: {{ thumbnail_count }};" aria-label="Product images">
        {% for image in product.images limit: 6 %}
          {% liquid
            assign thumbnail_colour_value = blank
            assign image_filename = image.src | split: '/' | last | downcase

            if colour_option != blank
              for colour_value in colour_option.values
                assign colour_value_name = colour_value.name | default: colour_value
                assign colour_value_handle = colour_value_name | handleize
                if image_filename contains colour_value_handle
                  assign thumbnail_colour_value = colour_value_name
                  break
                endif
              endfor
            endif
          %}
          <button
            class="aster-pdp__thumbnail{% if hero_image and image.id == hero_image.id %} is-active{% endif %}"
            type="button"
            aria-label="View image {{ forloop.index }} of {{ thumbnail_count }}"
            aria-pressed="{% if hero_image and image.id == hero_image.id %}true{% else %}false{% endif %}"
            data-aster-pdp-thumbnail
            data-image-id="{{ image.id }}"
            data-image-src="{{ image | image_url: width: 1600 }}"
            data-image-alt="{{ image.alt | default: product.title | escape }}"
            {% if thumbnail_colour_value != blank %}
              data-colour-value="{{ thumbnail_colour_value | escape }}"
              data-colour-option-index="{{ colour_option_index }}"
            {% endif %}
          >
            {% render 'image', class: 'aster-pdp__thumbnail-image', image: image, width: 240, sizes: '96px', priority: false %}
          </button>
        {% endfor %}
      </div>
    {% endif %}

    <button class="aster-pdp__main-media" type="button" aria-label="Enlarge {{ product.title | escape }} image" data-aster-pdp-zoom>
      {% if hero_image %}
        {% render 'image', class: 'aster-pdp__hero-image', image: hero_image, width: 1600, sizes: '(min-width: 1100px) min(760px, 52vw), (min-width: 750px) 58vw, 100vw', priority: true %}
        <span class="aster-pdp__zoom-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="6"></circle><path d="m16 16 4 4M11 8v6M8 11h6"></path></svg>
        </span>
      {% else %}
        <div class="aster-pdp__media-placeholder" aria-hidden="true"></div>
      {% endif %}
    </button>
  </div>

  <div class="aster-pdp__buy-panel">
    <div class="aster-pdp__buy-copy" data-aster-reveal="up">
      {% if pdp_eyebrow != blank %}<p class="aster-pdp__eyebrow">{{ pdp_eyebrow | escape }}</p>{% endif %}
      <h1 class="aster-pdp__title">{{ product.title | escape }}</h1>
      <div class="aster-pdp__reviews-slot" data-aster-pdp-reviews-summary hidden></div>
      {% if pdp_intro != blank %}<p class="aster-pdp__intro">{{ pdp_intro | escape | newline_to_br }}</p>{% endif %}
    </div>

    {% form 'product', product, class: 'aster-pdp__form' %}
      <input type="hidden" name="id" value="{{ current_variant.id }}" data-aster-pdp-variant-input>

      {% unless product.has_only_default_variant %}
        <div class="aster-pdp__options" data-aster-pdp-options data-aster-reveal="fade">
          {% for option in product.options_with_values %}
            {% liquid
              assign option_index = forloop.index0
              assign option_name_downcase = option.name | downcase
              assign is_colour_option = false
              if option_name_downcase == 'colour' or option_name_downcase == 'color'
                assign is_colour_option = true
              endif
              case option.position
                when 1
                  assign current_option_value = current_variant.option1
                when 2
                  assign current_option_value = current_variant.option2
                when 3
                  assign current_option_value = current_variant.option3
              endcase
            %}
            <fieldset class="aster-pdp__option{% if is_colour_option %} aster-pdp__option--swatches{% endif %}" data-aster-pdp-option-group data-option-index="{{ option_index }}">
              <legend class="visually-hidden">Choose {{ option.name | escape }}</legend>
              <div class="aster-pdp__option-values">
                {% for option_value in option.values %}
                  {% liquid
                    assign option_value_name = option_value.name | default: option_value
                    assign is_selected = false
                    if option_value_name == current_option_value
                      assign is_selected = true
                    endif
                    assign swatch_colour = option_value.swatch.color
                  %}
                  <button
                    class="aster-pdp__option-button{% if is_colour_option %} aster-pdp__swatch{% endif %}{% if is_selected %} is-selected{% endif %}"
                    type="button"
                    aria-label="Select {{ option.name | escape }}: {{ option_value_name | escape }}"
                    aria-pressed="{% if is_selected %}true{% else %}false{% endif %}"
                    data-aster-pdp-option
                    data-option-index="{{ option_index }}"
                    data-option-value="{{ option_value_name | escape }}"
                    data-swatch-name="{{ option_value_name | handleize }}"
                    {% if swatch_colour != blank %}style="--aster-pdp-swatch-colour: {{ swatch_colour }};"{% endif %}
                  >
                    {% if is_colour_option %}<span class="aster-pdp__swatch-dot" aria-hidden="true"></span><span class="aster-pdp__swatch-label">{{ option_value_name | escape }}</span>{% else %}<span>{{ option_value_name | escape }}</span>{% endif %}
                  </button>
                {% endfor %}
              </div>
            </fieldset>
          {% endfor %}
        </div>
      {% endunless %}

      <div class="aster-pdp__purchase-plan-slot" data-aster-purchase-plan-slot hidden></div>

      <div class="aster-pdp__purchase-row" data-aster-reveal="up">
        <div class="aster-pdp__quantity" data-aster-pdp-quantity>
          <button type="button" aria-label="Decrease quantity" data-aster-quantity-change="-1">−</button>
          <input id="AsterPdpQuantity" type="number" name="quantity" min="1" step="1" value="1" inputmode="numeric" aria-label="Quantity" data-aster-quantity-input>
          <button type="button" aria-label="Increase quantity" data-aster-quantity-change="1">+</button>
        </div>
        <button class="aster-pdp__add-button" type="submit" data-aster-pdp-add {% unless current_variant.available %}disabled{% endunless %}>
          <span data-aster-pdp-add-label>{% if current_variant.available %}Add to cart{% else %}Sold out{% endif %}</span>
          {% if current_variant.available %}<span class="aster-pdp__add-separator" aria-hidden="true">·</span><span data-aster-pdp-add-price>{{ current_variant.price | money }}</span>{% endif %}
        </button>
      </div>
    {% endform %}

    <div class="aster-pdp__reassurance" aria-label="Shopping information" data-aster-reveal="up">
      <a href="{{ shop.shipping_policy.url | default: routes.root_url }}"><span aria-hidden="true">↗</span><span>Shipping details</span></a>
      <a href="{{ shop.refund_policy.url | default: routes.root_url }}"><span aria-hidden="true">↺</span><span>Returns information</span></a>
      <span><span aria-hidden="true">◇</span><span>Secure checkout</span></span>
      <span><span aria-hidden="true">♡</span><span>Made for gifting</span></span>
    </div>

    {% if highlight_section != blank and highlight_section.items.value != blank %}
      <div class="aster-pdp__hero-highlights" data-aster-stagger>
        {% for item in highlight_section.items.value limit: 4 %}
          {% assign highlight_icon = item.icon.value | downcase %}
          <div class="aster-pdp__hero-highlight">
            <span class="aster-pdp__highlight-mark" aria-hidden="true">
              {% case highlight_icon %}{% when 'leaf' %}⌁{% when 'heart' %}♡{% when 'diamond' %}◇{% when 'book' %}▤{% when 'gift' %}⌑{% when 'calendar' %}□{% else %}○{% endcase %}
            </span>
            <div><p>{{ item.title.value | escape }}</p>{% if item.body.value != blank %}<span>{{ item.body.value | escape }}</span>{% endif %}</div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  <script type="application/json" data-aster-pdp-variants>[
    {% for variant in product.variants %}{"id":{{ variant.id | json }},"options":{{ variant.options | json }},"available":{{ variant.available | json }},"price":{{ variant.price | money | json }},"imageId":{% if variant.featured_image %}{{ variant.featured_image.id | json }}{% else %}null{% endif %},"imageSrc":{% if variant.featured_image %}{{ variant.featured_image | image_url: width: 1600 | json }}{% else %}null{% endif %},"imageAlt":{% if variant.featured_image %}{{ variant.featured_image.alt | default: product.title | json }}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}{% endfor %}
  ]</script>

  <dialog class="aster-pdp__lightbox" data-aster-pdp-lightbox>
    <button type="button" class="aster-pdp__lightbox-close" aria-label="Close image viewer" data-aster-pdp-lightbox-close>×</button>
    {% if hero_image %}<img src="{{ hero_image | image_url: width: 2000 }}" alt="{{ hero_image.alt | default: product.title | escape }}" width="{{ hero_image.width }}" height="{{ hero_image.height }}" data-aster-pdp-lightbox-image>{% endif %}
  </dialog>
</section>
