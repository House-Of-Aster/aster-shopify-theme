{% comment %}
  Global Aster colour schemes.
  The first scheme becomes the store default via :root.
  Any section can opt into another scheme with class="color-{{ section.settings.color_scheme }}".

  Canonical active brand palette:
  - Ivory: #F8F6EB
  - Aster red: #A52D34
  - Wine: #6B2331
  - Blush: #E8DAD2

  Blue (#3E6990) is part of the wider brand palette but is intentionally reserved
  and must not be used in the current storefront treatment unless explicitly reintroduced.
{% endcomment %}

{% style %}
  :root {
    --aster-colour-ivory: #f8f6eb;
    --aster-colour-red: #a52d34;
    --aster-colour-wine: #6b2331;
    --aster-colour-blush: #e8dad2;
  }

  {% for scheme in settings.color_schemes %}
    {% if forloop.first %}
      :root,
    {% endif %}
    .color-{{ scheme.id }} {
      --color-background: {{ scheme.settings.background }};
      --color-foreground: {{ scheme.settings.text }};
      --color-accent: {{ scheme.settings.accent }};
      --color-border: {{ scheme.settings.border }};
      --color-button-background: {{ scheme.settings.button }};
      --color-button-text: {{ scheme.settings.button_label }};
      --color-secondary-button-background: {{ scheme.settings.secondary_button }};
      --color-secondary-button-text: {{ scheme.settings.secondary_button_label }};
      --style-border-radius-inputs: 4px;
    }

    .color-{{ scheme.id }} {
      background-color: var(--color-background);
      color: var(--color-foreground);
    }
  {% endfor %}

  /* Password page: compact mobile Klaviyo grid. Kept here so Theme Editor cannot overwrite it. */
  @media screen and (max-width: 749px) {
    #AsterPasswordPage .aster-cinematic-password__signup form[data-testid^='klaviyo-form-'] > div:first-of-type {
      grid-template-columns: repeat(6, minmax(0, 1fr)) !important;
      grid-template-rows: auto auto auto !important;
      gap: 7px 6px !important;
    }

    #AsterPasswordPage .aster-cinematic-password__signup form[data-testid^='klaviyo-form-'] > div:first-of-type > [data-testid='form-row']:nth-of-type(1) {
      grid-column: 1 / span 3 !important;
      grid-row: 1 !important;
    }

    #AsterPasswordPage .aster-cinematic-password__signup form[data-testid^='klaviyo-form-'] > div:first-of-type > [data-testid='form-row']:nth-of-type(2) {
      grid-column: 4 / span 3 !important;
      grid-row: 1 !important;
    }

    #AsterPasswordPage .aster-cinematic-password__signup form[data-testid^='klaviyo-form-'] > div:first-of-type > [data-testid='form-row']:nth-of-type(3) {
      grid-column: 1 / span 4 !important;
      grid-row: 2 !important;
    }

    #AsterPasswordPage .aster-cinematic-password__signup form[data-testid^='klaviyo-form-'] > div:first-of-type > [data-testid='form-row']:nth-of-type(5) {
      grid-column: 5 / span 2 !important;
      grid-row: 2 !important;
    }

    #AsterPasswordPage .aster-cinematic-password__signup form[data-testid^='klaviyo-form-'] > div:first-of-type > [data-testid='form-row']:nth-of-type(4) {
      grid-column: 1 / -1 !important;
      grid-row: 3 !important;
    }
  }
{% endstyle %}
