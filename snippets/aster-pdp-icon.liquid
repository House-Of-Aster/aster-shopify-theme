{% comment %}
  Reusable Aster PDP line-icon library.
  Pass `icon` as one of: truck, return, shield, gift, heart, leaf, book,
  calendar, diamond, box, clock, check, sparkle.
{% endcomment %}

{% liquid
  assign icon_name = icon | default: 'sparkle' | downcase | strip
%}

<svg class="aster-pdp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {% case icon_name %}
    {% when 'truck' %}
      <path d="M3 6.5h11v9H3z"/><path d="M14 9h3.5l3 3v3.5H14z"/><circle cx="7" cy="17.5" r="1.5"/><circle cx="17.5" cy="17.5" r="1.5"/>
    {% when 'return' %}
      <path d="M9 7 5 11l4 4"/><path d="M5 11h8.5a5 5 0 0 1 5 5"/>
    {% when 'shield' %}
      <path d="M12 3 19 6v5.5c0 4.6-3 7.7-7 9.5-4-1.8-7-4.9-7-9.5V6z"/><path d="m9 12 2 2 4-4"/>
    {% when 'gift' %}
      <rect x="4" y="9" width="16" height="11" rx="1"/><path d="M12 9v11M3 9h18V6H3z"/><path d="M12 6c-2.8 0-5-.8-5-2.5C7 2.6 7.8 2 8.8 2 10.5 2 12 4.2 12 6Zm0 0c2.8 0 5-.8 5-2.5C17 2.6 16.2 2 15.2 2 13.5 2 12 4.2 12 6Z"/>
    {% when 'heart' %}
      <path d="M20.8 5.7a5 5 0 0 0-7.1 0L12 7.4l-1.7-1.7a5 5 0 1 0-7.1 7.1L12 21l8.8-8.2a5 5 0 0 0 0-7.1Z"/>
    {% when 'leaf' %}
      <path d="M19.5 4.5C12 4.5 7 8 7 14c0 2.8 1.7 5 4.5 5 6 0 8-7.5 8-14.5Z"/><path d="M5 21c2.5-5 6-8.5 11-11"/>
    {% when 'book' %}
      <path d="M4 5.5A3.5 3.5 0 0 1 7.5 2H11v17H7.5A3.5 3.5 0 0 0 4 22Z"/><path d="M20 5.5A3.5 3.5 0 0 0 16.5 2H13v17h3.5A3.5 3.5 0 0 1 20 22Z"/>
    {% when 'calendar' %}
      <rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4M17 3v4M3 10h18"/>
    {% when 'diamond' %}
      <path d="M7 4h10l4 5-9 11L3 9z"/><path d="m7 4 5 16 5-16M3 9h18"/>
    {% when 'box' %}
      <path d="m4 7 8-4 8 4-8 4z"/><path d="m4 7 8 4 8-4v10l-8 4-8-4zM12 11v10"/>
    {% when 'clock' %}
      <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
    {% when 'check' %}
      <circle cx="12" cy="12" r="9"/><path d="m8 12 2.5 2.5L16 9"/>
    {% when 'sparkle' %}
      <path d="M12 2c.7 4.8 3.2 7.3 8 8-4.8.7-7.3 3.2-8 8-.7-4.8-3.2-7.3-8-8 4.8-.7 7.3-3.2 8-8Z"/><path d="M19 16c.3 2 1.3 3 3 3-1.7.3-2.7 1.3-3 3-.3-1.7-1.3-2.7-3-3 1.7-.3 2.7-1.3 3-3Z"/>
    {% else %}
      <circle cx="12" cy="12" r="8"/>
  {% endcase %}
</svg>
