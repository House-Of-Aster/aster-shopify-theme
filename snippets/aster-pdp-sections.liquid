{% comment %}Shared Aster PDP storytelling renderer. Planner-safe revision.{% endcomment %}
{% liquid
  assign pdp_sections = product.metafields.aster.pdp_sections.value
  assign story_section = nil
  assign steps_section = nil
  assign details_section = nil
  assign faq_section = nil
  for pdp_section in pdp_sections
    assign section_type = pdp_section.section_type.value | downcase | strip
    if section_type == 'story'
      assign story_section = pdp_section
    elsif section_type == 'steps'
      assign steps_section = pdp_section
    elsif section_type == 'details'
      assign details_section = pdp_section
    elsif section_type == 'faq'
      assign faq_section = pdp_section
    endif
  endfor
%}

{% if story_section != blank %}
  {% assign story_image = product.images[3] | default: product.images[1] | default: product.featured_image %}
  <section class="aster-pdp__story" data-aster-reveal="up">
    <div class="aster-pdp__story-copy">
      {% if story_section.eyebrow.value != blank %}<p class="aster-pdp__section-eyebrow">{{ story_section.eyebrow.value | escape }}</p>{% endif %}
      <h2 class="aster-pdp__section-title">{{ story_section.heading.value | escape }}</h2>
      {% if story_section.body.value != blank %}<div class="aster-pdp__section-body">{{ story_section.body.value | escape | newline_to_br }}</div>{% endif %}
    </div>
    {% if story_image %}<div class="aster-pdp__story-media">{% render 'image', class: 'aster-pdp__story-image', image: story_image, width: 1600, sizes: '(min-width: 750px) 50vw, 100vw', priority: false %}</div>{% endif %}
  </section>
{% endif %}

{% if steps_section != blank and steps_section.items.value != blank %}
  <section class="aster-pdp__content-section aster-pdp__content-section--steps" data-aster-reveal="up">
    {% if steps_section.eyebrow.value != blank %}<p class="aster-pdp__section-eyebrow">{{ steps_section.eyebrow.value | escape }}</p>{% endif %}
    <h2 class="aster-pdp__section-title">{{ steps_section.heading.value | escape }}</h2>
    <ol class="aster-pdp__steps-grid">
      {% for item in steps_section.items.value limit: 4 %}
        <li class="aster-pdp__step"><div class="aster-pdp__step-topline"><span class="aster-pdp__step-number">0{{ forloop.index }}</span><span class="aster-pdp__step-icon" aria-hidden="true">○</span></div><h3>{{ item.title.value | escape }}</h3>{% if item.body.value != blank %}<p>{{ item.body.value | escape | newline_to_br }}</p>{% endif %}</li>
      {% endfor %}
    </ol>
  </section>
{% endif %}

{% if details_section != blank or faq_section != blank %}
  <section class="aster-pdp__content-section aster-pdp__detail-faq" data-aster-reveal="up">
    {% if details_section != blank and details_section.items.value != blank %}
      <div class="aster-pdp__details-panel">
        {% if details_section.eyebrow.value != blank %}<p class="aster-pdp__section-eyebrow">{{ details_section.eyebrow.value | escape }}</p>{% endif %}
        <h2 class="aster-pdp__section-title">{{ details_section.heading.value | escape }}</h2>
        <dl class="aster-pdp__spec-list">{% for item in details_section.items.value %}<div class="aster-pdp__spec-row"><dt>{{ item.title.value | escape }}</dt><dd>{{ item.value.value | default: item.body.value | escape }}</dd></div>{% endfor %}</dl>
      </div>
    {% endif %}
    {% if faq_section != blank and faq_section.items.value != blank %}
      <div class="aster-pdp__faq-panel">
        {% if faq_section.eyebrow.value != blank %}<p class="aster-pdp__section-eyebrow">{{ faq_section.eyebrow.value | escape }}</p>{% endif %}
        <h2 class="aster-pdp__section-title">{{ faq_section.heading.value | escape }}</h2>
        <div class="aster-pdp__faq-list">{% for item in faq_section.items.value %}<details class="aster-pdp__faq-item"><summary><span>{{ item.title.value | escape }}</span><span class="aster-pdp__faq-plus" aria-hidden="true">+</span></summary>{% if item.body.value != blank %}<div class="aster-pdp__faq-answer">{{ item.body.value | escape | newline_to_br }}</div>{% endif %}</details>{% endfor %}</div>
      </div>
    {% endif %}
  </section>
{% endif %}
