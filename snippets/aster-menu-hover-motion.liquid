{% style %}
  @media (min-width: 990px) and (hover: hover) and (pointer: fine) {
    .aster-header[data-aster-menu-root] a.aster-header__menu-link::before {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: -3px;
      height: 1px;
      background: currentColor;
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform 280ms cubic-bezier(0.65, 0, 0.35, 1);
      pointer-events: none;
    }

    .aster-header[data-aster-menu-root] a.aster-header__menu-link::after {
      content: '›';
      position: absolute;
      top: 50%;
      left: calc(100% + 9px);
      font-family: var(--font-body--family);
      font-size: 0.78em;
      font-weight: 400;
      line-height: 1;
      opacity: 0;
      transform: translate(-12px, -50%);
      transition:
        opacity 220ms cubic-bezier(0.65, 0, 0.35, 1),
        transform 280ms cubic-bezier(0.65, 0, 0.35, 1);
      pointer-events: none;
    }

    .aster-header[data-aster-menu-root] a.aster-header__menu-link:hover::before,
    .aster-header[data-aster-menu-root] a.aster-header__menu-link:focus-visible::before {
      transform: scaleX(1);
    }

    .aster-header[data-aster-menu-root] a.aster-header__menu-link:hover::after,
    .aster-header[data-aster-menu-root] a.aster-header__menu-link:focus-visible::after {
      opacity: 1;
      transform: translate(0, -50%);
    }
  }

  @media (min-width: 990px) and (prefers-reduced-motion: reduce) {
    .aster-header[data-aster-menu-root] a.aster-header__menu-link::before,
    .aster-header[data-aster-menu-root] a.aster-header__menu-link::after {
      transition: none;
    }
  }
{% endstyle %}
