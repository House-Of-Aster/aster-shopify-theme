{% style %}
  /* Phase 2.4 visual QA refinements: compact newsletter handoff, continuous field fill, balanced utility/footer rows, and global content alignment. */
  .aster-footer__inner {
    width: min(1400px, calc(100% - 40px)) !important;
  }

  .aster-footer__eyebrow {
    display: none;
  }

  .aster-footer__newsletter-heading {
    font-size: clamp(34px, 3vw, 46px);
    line-height: 1.02;
  }

  .aster-footer__newsletter-text {
    max-width: 54ch;
    margin-top: 10px;
    font-family: var(--font-body--family);
    font-size: clamp(14px, 1.15vw, 17px);
    line-height: 1.45;
  }

  .aster-footer__newsletter-form {
    margin-top: 18px;
  }

  .aster-footer__newsletter-control {
    min-height: 52px;
    background: color-mix(in srgb, var(--color-foreground) 6%, var(--color-background));
  }

  .aster-footer__newsletter-input {
    min-height: 50px;
    background: transparent !important;
    border: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    appearance: none;
    -webkit-appearance: none;
  }

  .aster-footer__newsletter-button {
    min-height: 50px;
    min-width: clamp(190px, 18vw, 250px);
    position: relative;
    z-index: 1;
    white-space: nowrap;
  }

  .aster-footer__navigation + .aster-footer__rule {
    margin: clamp(30px, 3vw, 42px) 0 18px;
  }

  .aster-footer__utility {
    min-height: 0;
    justify-content: center;
    gap: 0;
  }

  .aster-footer__utility + .aster-footer__rule {
    margin: 18px 0 22px;
  }

  .aster-footer__bottom {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 24px;
  }

  .aster-footer__copyright {
    justify-self: start;
  }

  .aster-footer__legal {
    justify-self: center;
    justify-content: center;
  }

  .aster-footer__bottom .aster-footer__payments {
    justify-self: end;
    justify-content: flex-end;
    max-width: 100%;
  }

  @media (max-width: 749px) {
    .aster-footer__newsletter {
      margin-top: 38px;
    }

    .aster-footer__newsletter-heading {
      font-size: clamp(30px, 9vw, 36px);
      line-height: 1.04;
    }

    .aster-footer__newsletter-text {
      max-width: 32ch;
      margin-top: 10px;
      font-size: 15px;
      line-height: 1.42;
    }

    .aster-footer__newsletter-form {
      margin-top: 20px;
    }

    .aster-footer__newsletter-control {
      min-height: 52px;
      grid-template-columns: minmax(0, 1fr) minmax(138px, 46%);
    }

    .aster-footer__newsletter-input {
      min-height: 50px;
      padding-inline: 14px;
      font-size: 13px;
    }

    .aster-footer__newsletter-button {
      min-width: 0;
      min-height: 50px;
      padding-inline: 13px;
      gap: 8px;
      font-size: 8px;
      letter-spacing: 0.1em;
    }

    .aster-footer__newsletter-arrow {
      font-size: 16px;
    }

    .aster-footer__utility {
      padding: 18px 0 0;
      gap: 0;
    }

    .aster-footer__utility + .aster-footer__rule {
      margin: 18px 0 0;
    }

    .aster-footer__bottom {
      padding-top: 22px;
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      gap: 14px;
    }

    .aster-footer__copyright,
    .aster-footer__legal,
    .aster-footer__bottom .aster-footer__payments {
      justify-self: center;
    }

    .aster-footer__bottom .aster-footer__payments {
      justify-content: center;
      margin-top: 2px;
    }
  }

  @media (max-width: 390px) {
    .aster-footer__newsletter-control {
      grid-template-columns: minmax(0, 1fr) 138px;
    }

    .aster-footer__newsletter-button {
      padding-inline: 11px;
      letter-spacing: 0.08em;
    }
  }
{% endstyle %}

<script>
  (() => {
    const placeFooterPayments = (root = document) => {
      const footers = [];

      if (root instanceof Element && root.matches('[data-aster-footer]')) {
        footers.push(root);
      }

      if (root.querySelectorAll) {
        footers.push(...root.querySelectorAll('[data-aster-footer]'));
      }

      footers.forEach((footer) => {
        const payments = footer.querySelector('.aster-footer__payments');
        const bottom = footer.querySelector('.aster-footer__bottom');

        if (payments && bottom && payments.parentElement !== bottom) {
          bottom.appendChild(payments);
        }
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => placeFooterPayments(), { once: true });
    } else {
      placeFooterPayments();
    }

    document.addEventListener('shopify:section:load', (event) => placeFooterPayments(event.target));
  })();
</script>
