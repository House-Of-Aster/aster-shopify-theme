{% doc %}
  Global Aster storefront footer used inside the Footer section group.
  Navigation is driven by one nested Shopify menu: top-level links are the
  clickable column headings and their children are the supporting links.
  No decorative imagery is used.
{% enddoc %}

<footer
  id="AsterFooter-{{ section.id }}"
  class="aster-footer full-width color-{{ section.settings.color_scheme }}"
  data-aster-footer
  {{ section.shopify_attributes }}
>
  <div class="aster-footer__inner">
    <div class="aster-footer__intro">
      <div class="aster-footer__brand">
        <a class="aster-footer__brand-link" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
          {% if settings.logo != blank %}
            <span
              class="aster-footer__logo"
              aria-hidden="true"
              style="--aster-footer-logo-mask: url('{{ settings.logo | image_url: width: 1200 }}'); --aster-footer-logo-ratio: {{ settings.logo.aspect_ratio | default: 3 }};"
            ></span>
          {% else %}
            <span class="aster-footer__wordmark">{{ shop.name | escape }}</span>
          {% endif %}
        </a>

        {% if section.settings.brand_tagline != blank %}
          <p class="aster-footer__tagline">{{ section.settings.brand_tagline | escape }}</p>
        {% endif %}

        {% if section.settings.brand_text != blank %}
          <p class="aster-footer__brand-text">{{ section.settings.brand_text | escape | newline_to_br }}</p>
        {% endif %}
      </div>

      <div class="aster-footer__newsletter">
        {% if section.settings.newsletter_eyebrow != blank %}
          <p class="aster-footer__eyebrow">{{ section.settings.newsletter_eyebrow | escape }}</p>
        {% endif %}

        {% if section.settings.newsletter_heading != blank %}
          <h2 class="aster-footer__newsletter-heading">{{ section.settings.newsletter_heading | escape }}</h2>
        {% endif %}

        {% if section.settings.newsletter_text != blank %}
          <p class="aster-footer__newsletter-text">{{ section.settings.newsletter_text | escape }}</p>
        {% endif %}

        {% form 'customer', class: 'aster-footer__newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="visually-hidden" for="AsterFooterEmail-{{ section.id }}">Email address</label>
          <div class="aster-footer__newsletter-control">
            <input
              id="AsterFooterEmail-{{ section.id }}"
              class="aster-footer__newsletter-input"
              type="email"
              name="contact[email]"
              value="{% if customer %}{{ customer.email }}{% endif %}"
              autocomplete="email"
              autocapitalize="off"
              spellcheck="false"
              placeholder="Your email address"
              required
            >
            <button class="aster-footer__newsletter-button" type="submit">
              <span>{{ section.settings.newsletter_button_label | escape }}</span>
              <span class="aster-footer__newsletter-arrow" aria-hidden="true">→</span>
            </button>
          </div>

          {% if form.posted_successfully? %}
            <p class="aster-footer__form-message" role="status">You’re on the list. Welcome to Aster.</p>
          {% elsif form.errors %}
            <div class="aster-footer__form-message" role="alert">{{ form.errors | default_errors }}</div>
          {% endif %}
        {% endform %}
      </div>
    </div>

    <div class="aster-footer__rule" aria-hidden="true"></div>

    <nav class="aster-footer__navigation" aria-label="Footer navigation">
      {% if section.settings.footer_menu != blank %}
        {% for link in section.settings.footer_menu.links %}
          <div class="aster-footer__group" data-aster-footer-group>
            <div class="aster-footer__group-header">
              <a class="aster-footer__group-heading-link" href="{{ link.url }}">
                <span>{{ link.title | escape }}</span>
              </a>

              {% if link.links != blank %}
                <button
                  class="aster-footer__group-toggle"
                  type="button"
                  aria-expanded="true"
                  aria-label="Toggle {{ link.title | escape }} links"
                  aria-controls="AsterFooterGroup-{{ section.id }}-{{ forloop.index }}"
                  data-aster-footer-toggle
                >
                  <svg class="aster-footer__group-chevron" aria-hidden="true" viewBox="0 0 18 10" fill="none">
                    <path d="M1 1l8 8 8-8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </button>
              {% endif %}
            </div>

            {% if link.links != blank %}
              <div
                id="AsterFooterGroup-{{ section.id }}-{{ forloop.index }}"
                class="aster-footer__group-panel"
                data-aster-footer-panel
              >
                <ul class="aster-footer__group-links" role="list">
                  {% for child_link in link.links %}
                    <li><a href="{{ child_link.url }}">{{ child_link.title | escape }}</a></li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}
          </div>
        {% endfor %}
      {% else %}
        {% assign fallback_groups = 'Planner|Rituals|Journal|Our World|Support' | split: '|' %}
        {% for fallback_group in fallback_groups %}
          <div class="aster-footer__group" data-aster-footer-group>
            <div class="aster-footer__group-header">
              <a class="aster-footer__group-heading-link" href="{{ routes.root_url }}"><span>{{ fallback_group }}</span></a>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </nav>

    <div class="aster-footer__rule" aria-hidden="true"></div>

    {% liquid
      assign has_social_links = false
      if section.settings.instagram_url != blank or section.settings.pinterest_url != blank or section.settings.tiktok_url != blank or section.settings.youtube_url != blank or section.settings.contact_email != blank
        assign has_social_links = true
      endif
    %}

    <div class="aster-footer__utility">
      {% if has_social_links %}
        <div class="aster-footer__socials" aria-label="Aster social links">
          {% if section.settings.instagram_url != blank %}
            <a href="{{ section.settings.instagram_url }}" aria-label="Instagram" target="_blank" rel="noopener">
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><rect x="3.5" y="3.5" width="17" height="17" rx="5" stroke="currentColor" stroke-width="1.5"></rect><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"></circle><circle cx="17.5" cy="6.7" r="1" fill="currentColor"></circle></svg>
            </a>
          {% endif %}
          {% if section.settings.pinterest_url != blank %}
            <a href="{{ section.settings.pinterest_url }}" aria-label="Pinterest" target="_blank" rel="noopener">
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M12.2 3.5c-4.7 0-7.2 3.4-7.2 6.3 0 2.1.8 4 2.5 4.7.3.1.6 0 .7-.3l.3-1.2c.1-.3.1-.4-.2-.7-.5-.6-.9-1.5-.9-2.7 0-3.1 2.3-5.9 6-5.9 3.3 0 5.1 2 5.1 4.7 0 3.5-1.6 6.5-3.9 6.5-1.3 0-2.3-1.1-2-2.4.4-1.6 1.1-3.3 1.1-4.4 0-1-.5-1.8-1.6-1.8-1.3 0-2.3 1.3-2.3 3.1 0 1.1.4 1.9.4 1.9l-1.6 6.8c-.5 2-.1 4.5 0 4.8.1.2.3.3.4.1.2-.2 2-2.5 2.7-4.8.2-.7 1.1-4.2 1.1-4.2.6 1.1 2.2 2 3.9 2 5.1 0 8.6-3.7 8.6-8.7C21.8 6.4 18.6 3.5 12.2 3.5Z" fill="currentColor" transform="scale(.83) translate(2.1 0)"></path></svg>
            </a>
          {% endif %}
          {% if section.settings.tiktok_url != blank %}
            <a href="{{ section.settings.tiktok_url }}" aria-label="TikTok" target="_blank" rel="noopener">
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M14.2 3.5c.4 2.2 1.7 3.6 3.8 3.8v3.1c-1.4 0-2.7-.4-3.8-1.2v5.8a5.6 5.6 0 1 1-4.8-5.5v3.2a2.5 2.5 0 1 0 1.7 2.3V3.5h3.1Z" fill="currentColor"></path></svg>
            </a>
          {% endif %}
          {% if section.settings.youtube_url != blank %}
            <a href="{{ section.settings.youtube_url }}" aria-label="YouTube" target="_blank" rel="noopener">
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M20.2 7.1a2.7 2.7 0 0 0-1.9-1.9C16.6 4.8 12 4.8 12 4.8s-4.6 0-6.3.4a2.7 2.7 0 0 0-1.9 1.9C3.4 8.8 3.4 12 3.4 12s0 3.2.4 4.9a2.7 2.7 0 0 0 1.9 1.9c1.7.4 6.3.4 6.3.4s4.6 0 6.3-.4a2.7 2.7 0 0 0 1.9-1.9c.4-1.7.4-4.9.4-4.9s0-3.2-.4-4.9Z" stroke="currentColor" stroke-width="1.5"></path><path d="m10 9.3 5 2.7-5 2.7V9.3Z" fill="currentColor"></path></svg>
            </a>
          {% endif %}
          {% if section.settings.contact_email != blank %}
            <a href="mailto:{{ section.settings.contact_email | escape }}" aria-label="Email Aster">
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.5"></rect><path d="m4.5 7 7.5 6 7.5-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </a>
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.show_payment_icons and shop.enabled_payment_types != empty %}
        <div class="aster-footer__payments" aria-label="Accepted payment methods">
          {% for type in shop.enabled_payment_types %}
            <span class="aster-footer__payment-icon">{{ type | payment_type_svg_tag }}</span>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="aster-footer__rule" aria-hidden="true"></div>

    <div class="aster-footer__bottom">
      <p class="aster-footer__copyright">© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. All rights reserved.</p>

      {% if section.settings.show_policy_links %}
        <div class="aster-footer__legal" aria-label="Legal links">
          {% if shop.privacy_policy != blank %}
            <a href="{{ shop.privacy_policy.url }}">Privacy</a>
          {% endif %}
          {% if shop.terms_of_service != blank %}
            <a href="{{ shop.terms_of_service.url }}">Terms</a>
          {% endif %}
          {% if section.settings.cookie_url != blank %}
            <a href="{{ section.settings.cookie_url }}">{{ section.settings.cookie_label | escape }}</a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>

  <script>
    (() => {
      const footer = document.getElementById('AsterFooter-{{ section.id }}');
      if (!footer) return;

      const desktop = window.matchMedia('(min-width: 750px)');
      const groups = Array.from(footer.querySelectorAll('[data-aster-footer-group]'));

      const syncGroups = () => {
        groups.forEach((group) => {
          const toggle = group.querySelector('[data-aster-footer-toggle]');
          const panel = group.querySelector('[data-aster-footer-panel]');
          if (!toggle || !panel) return;

          if (desktop.matches) {
            toggle.setAttribute('aria-expanded', 'true');
            toggle.setAttribute('tabindex', '-1');
            panel.hidden = false;
          } else {
            toggle.removeAttribute('tabindex');
            toggle.setAttribute('aria-expanded', 'false');
            panel.hidden = true;
          }
        });
      };

      groups.forEach((group) => {
        const toggle = group.querySelector('[data-aster-footer-toggle]');
        const panel = group.querySelector('[data-aster-footer-panel]');
        if (!toggle || !panel) return;

        toggle.addEventListener('click', () => {
          if (desktop.matches) return;
          const expanded = toggle.getAttribute('aria-expanded') === 'true';
          toggle.setAttribute('aria-expanded', expanded ? 'false' : 'true');
          panel.hidden = expanded;
        });
      });

      syncGroups();
      if (desktop.addEventListener) desktop.addEventListener('change', syncGroups);
      else desktop.addListener(syncGroups);
    })();
  </script>
</footer>

{% stylesheet %}
  .aster-footer {
    display: block;
    width: 100%;
    margin: 0;
    background: var(--color-background);
    color: var(--color-foreground);
    font-family: var(--font-body--family);
  }

  .aster-footer__inner {
    width: min(1480px, calc(100% - 64px));
    margin: 0 auto;
    padding: clamp(72px, 7vw, 112px) 0 28px;
  }

  .aster-footer a {
    color: inherit;
    text-decoration: none;
  }

  .aster-footer__intro {
    display: grid;
    grid-template-columns: minmax(240px, 0.72fr) minmax(0, 1.7fr);
    gap: clamp(56px, 7vw, 116px);
    align-items: end;
  }

  .aster-footer__brand {
    min-width: 0;
  }

  .aster-footer__brand-link {
    display: inline-flex;
    width: fit-content;
    align-items: center;
  }

  .aster-footer__logo {
    display: block;
    width: clamp(190px, 17vw, 270px);
    aspect-ratio: var(--aster-footer-logo-ratio);
    background: currentColor;
    -webkit-mask-image: var(--aster-footer-logo-mask);
    mask-image: var(--aster-footer-logo-mask);
    -webkit-mask-position: left center;
    mask-position: left center;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: contain;
    mask-size: contain;
  }

  .aster-footer__wordmark {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(54px, 5vw, 84px);
    line-height: 0.95;
  }

  .aster-footer__tagline,
  .aster-footer__eyebrow {
    margin: 0;
    font-family: var(--font-subheading--family);
    font-size: 11px;
    line-height: 1.2;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .aster-footer__tagline {
    margin-top: 18px;
    opacity: 0.72;
  }

  .aster-footer__brand-text {
    max-width: 29ch;
    margin: 28px 0 0;
    font-family: var(--font-heading--family);
    font-size: clamp(18px, 1.45vw, 23px);
    line-height: 1.45;
    opacity: 0.88;
  }

  .aster-footer__newsletter {
    min-width: 0;
  }

  .aster-footer__eyebrow {
    margin-bottom: 18px;
    opacity: 0.72;
  }

  .aster-footer__newsletter-heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    font-size: clamp(44px, 4.2vw, 72px);
    line-height: 1;
    letter-spacing: var(--font-heading-letter-spacing);
    text-transform: var(--font-heading-transform);
  }

  .aster-footer__newsletter-text {
    max-width: 49ch;
    margin: 18px 0 0;
    font-family: var(--font-heading--family);
    font-size: clamp(18px, 1.5vw, 24px);
    line-height: 1.45;
  }

  .aster-footer__newsletter-form {
    margin-top: 30px;
  }

  .aster-footer__newsletter-control {
    min-height: 66px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: stretch;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 22%, transparent);
    border-radius: var(--aster-radius);
  }

  .aster-footer__newsletter-input {
    width: 100%;
    min-width: 0;
    min-height: 64px;
    margin: 0;
    padding: 0 24px;
    border: 0;
    border-radius: 0;
    outline: none;
    background: transparent;
    color: var(--color-foreground);
    font: inherit;
    box-shadow: none;
  }

  .aster-footer__newsletter-input::placeholder {
    color: var(--color-foreground);
    opacity: 0.52;
  }

  .aster-footer__newsletter-input:focus-visible {
    background: color-mix(in srgb, var(--color-foreground) 5%, transparent);
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--color-foreground) 52%, transparent);
  }

  .aster-footer__newsletter-button {
    min-width: clamp(210px, 20vw, 290px);
    min-height: 64px;
    margin: 0;
    padding: 0 24px 0 30px;
    border: 0;
    border-radius: calc(var(--aster-radius) - 1px);
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    background: var(--color-button-background);
    color: var(--color-button-text);
    font-family: var(--font-button--family);
    font-weight: var(--font-button-weight);
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .aster-footer__newsletter-arrow {
    font-size: 20px;
    line-height: 1;
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .aster-footer__form-message {
    margin: 12px 0 0;
    font-size: 13px;
    line-height: 1.4;
  }

  .aster-footer__form-message ul {
    margin: 0;
    padding-left: 18px;
  }

  .aster-footer__rule {
    width: 100%;
    height: 1px;
    margin: clamp(42px, 4vw, 64px) 0;
    background: color-mix(in srgb, var(--color-foreground) 20%, transparent);
  }

  .aster-footer__navigation {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(24px, 4vw, 72px);
    font-family: var(--font-body--family);
  }

  .aster-footer__group {
    min-width: 0;
  }

  .aster-footer__group-header {
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  .aster-footer__group-heading-link {
    position: relative;
    width: fit-content;
    min-width: 0;
    display: inline-flex;
    align-items: center;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    font-size: clamp(21px, 1.8vw, 27px);
    line-height: 1.08;
    letter-spacing: var(--font-heading-letter-spacing);
    text-transform: var(--font-heading-transform);
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .aster-footer__group-heading-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .aster-footer__group-toggle {
    width: 40px;
    height: 40px;
    margin: 0;
    padding: 0;
    border: 0;
    display: none;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    background: transparent;
    color: inherit;
  }

  .aster-footer__group-chevron {
    width: 18px;
    height: 10px;
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .aster-footer__group-panel {
    margin-top: 18px;
  }

  .aster-footer__group-links {
    margin: 0;
    padding: 0;
    display: grid;
    gap: 11px;
    list-style: none;
  }

  .aster-footer__group-links a {
    width: fit-content;
    display: inline-block;
    font-size: 14px;
    line-height: 1.35;
    opacity: 0.86;
    transition:
      opacity 180ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .aster-footer__utility {
    min-height: 42px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 34px;
  }

  .aster-footer__socials,
  .aster-footer__payments {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
  }

  .aster-footer__socials {
    gap: 18px;
  }

  .aster-footer__socials a {
    width: 28px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    opacity: 0.9;
    transition:
      opacity 180ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .aster-footer__socials svg {
    width: 21px;
    height: 21px;
  }

  .aster-footer__payments {
    gap: 8px;
  }

  .aster-footer__payment-icon {
    height: 28px;
    display: inline-flex;
    align-items: center;
    opacity: 0.65;
  }

  .aster-footer__payment-icon svg {
    width: auto;
    height: 26px;
  }

  .aster-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    font-size: 12px;
    line-height: 1.4;
    opacity: 0.72;
  }

  .aster-footer__copyright {
    margin: 0;
  }

  .aster-footer__legal {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0;
  }

  .aster-footer__legal a {
    display: inline-flex;
    align-items: center;
  }

  .aster-footer__legal a + a::before {
    content: '';
    width: 1px;
    height: 13px;
    margin: 0 16px;
    background: currentColor;
    opacity: 0.35;
  }

  @media (hover: hover) and (pointer: fine) {
    .aster-footer__newsletter-button:hover .aster-footer__newsletter-arrow {
      transform: translateX(4px);
    }

    .aster-footer__group-heading-link:hover {
      transform: translateX(4px);
    }

    .aster-footer__group-heading-link:hover::after {
      transform: scaleX(1);
    }

    .aster-footer__group-links a:hover {
      opacity: 1;
      transform: translateX(4px);
    }

    .aster-footer__socials a:hover {
      opacity: 1;
      transform: translateY(-3px);
    }
  }

  @media (max-width: 989px) {
    .aster-footer__inner {
      width: calc(100% - 40px);
    }

    .aster-footer__intro {
      grid-template-columns: minmax(180px, 0.7fr) minmax(0, 1.3fr);
      gap: 40px;
    }

    .aster-footer__navigation {
      gap: 20px;
    }

    .aster-footer__newsletter-button {
      min-width: 190px;
    }
  }

  @media (max-width: 749px) {
    .aster-footer__inner {
      width: calc(100% - 30px);
      padding: 58px 0 26px;
    }

    .aster-footer__intro {
      display: block;
    }

    .aster-footer__logo {
      width: min(190px, 58vw);
    }

    .aster-footer__wordmark {
      font-size: 56px;
    }

    .aster-footer__tagline {
      margin-top: 14px;
      font-size: 9px;
    }

    .aster-footer__brand-text {
      display: none;
    }

    .aster-footer__newsletter {
      margin-top: 52px;
    }

    .aster-footer__eyebrow {
      display: none;
    }

    .aster-footer__newsletter-heading {
      font-size: clamp(38px, 12vw, 52px);
    }

    .aster-footer__newsletter-text {
      max-width: 30ch;
      margin-top: 14px;
      font-size: 18px;
      line-height: 1.5;
    }

    .aster-footer__newsletter-form {
      margin-top: 28px;
    }

    .aster-footer__newsletter-control {
      min-height: 58px;
      grid-template-columns: minmax(0, 1fr) minmax(138px, 42%);
    }

    .aster-footer__newsletter-input {
      min-height: 56px;
      padding: 0 14px;
      font-size: 14px;
    }

    .aster-footer__newsletter-button {
      min-width: 0;
      min-height: 56px;
      padding: 0 14px 0 16px;
      gap: 8px;
      font-size: 9px;
      letter-spacing: 0.14em;
    }

    .aster-footer__newsletter-arrow {
      font-size: 17px;
    }

    .aster-footer__rule {
      margin: 38px 0 0;
    }

    .aster-footer__navigation {
      display: block;
    }

    .aster-footer__group {
      border-bottom: 1px solid color-mix(in srgb, var(--color-foreground) 18%, transparent);
    }

    .aster-footer__group-header {
      min-height: 72px;
      padding: 0 2px;
    }

    .aster-footer__group-heading-link {
      font-size: clamp(22px, 7vw, 28px);
    }

    .aster-footer__group-toggle {
      display: inline-flex;
      cursor: pointer;
    }

    .aster-footer__group-toggle[aria-expanded='true'] .aster-footer__group-chevron {
      transform: rotate(180deg);
    }

    .aster-footer__group-panel {
      margin: 0;
      padding: 0 2px 24px;
    }

    .aster-footer__group-panel[hidden] {
      display: none;
    }

    .aster-footer__group-links {
      gap: 10px;
    }

    .aster-footer__group-links a {
      font-size: 14px;
    }

    .aster-footer__navigation + .aster-footer__rule {
      display: none;
    }

    .aster-footer__utility {
      min-height: 0;
      padding: 28px 0 0;
      display: grid;
      justify-items: center;
      gap: 28px;
    }

    .aster-footer__socials {
      justify-content: center;
      gap: 26px;
    }

    .aster-footer__socials a {
      width: 30px;
      height: 30px;
    }

    .aster-footer__socials svg {
      width: 23px;
      height: 23px;
    }

    .aster-footer__payments {
      justify-content: center;
      gap: 6px;
    }

    .aster-footer__payment-icon {
      height: 26px;
    }

    .aster-footer__payment-icon svg {
      height: 24px;
      max-width: 48px;
    }

    .aster-footer__utility + .aster-footer__rule {
      margin-top: 32px;
    }

    .aster-footer__bottom {
      padding-top: 28px;
      display: grid;
      justify-items: center;
      gap: 18px;
      text-align: center;
      font-size: 12px;
    }

    .aster-footer__legal {
      justify-content: center;
    }
  }

  @media (max-width: 390px) {
    .aster-footer__newsletter-control {
      grid-template-columns: minmax(0, 1fr) 130px;
    }

    .aster-footer__newsletter-button {
      padding-inline: 12px;
      letter-spacing: 0.1em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aster-footer__newsletter-arrow,
    .aster-footer__group-heading-link,
    .aster-footer__group-heading-link::after,
    .aster-footer__group-chevron,
    .aster-footer__group-links a,
    .aster-footer__socials a {
      transition: none;
    }

    .aster-footer__newsletter-button:hover .aster-footer__newsletter-arrow,
    .aster-footer__group-heading-link:hover,
    .aster-footer__group-links a:hover,
    .aster-footer__socials a:hover {
      transform: none;
    }

    .aster-footer__group-heading-link:hover::after {
      transform: scaleX(1);
    }
  }
{% endstylesheet %}

