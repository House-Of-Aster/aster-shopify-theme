{% if section.settings.bear_image != blank %}
  <style>
    #shopify-section-{{ section.id }} {
      height: 0;
      min-height: 0;
      margin: 0;
      padding: 0;
    }

    #AsterPasswordPage [data-aster-landing]::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 15;
      pointer-events: none;
      opacity: {{ section.settings.bear_opacity | divided_by: 100.0 }};
      background-image: url('{{ section.settings.bear_image | image_url: width: 2000 }}');
      background-repeat: no-repeat;
      background-position: {{ section.settings.bear_x_desktop }}% 100%;
      background-size: {{ section.settings.bear_width_desktop_px }}px auto;
    }

    @media screen and (max-width: 749px) {
      #AsterPasswordPage [data-aster-landing]::before {
        background-position: {{ section.settings.bear_x_mobile }}% 100%;
        background-size: {{ section.settings.bear_width_mobile_px }}px auto;
      }
    }
  </style>
{% endif %}

{% schema %}
{
  "name": "Bear silhouette",
  "tag": "section",
  "class": "section-aster-bear-layer",
  "settings": [
    {
      "type": "image_picker",
      "id": "bear_image",
      "label": "Bear silhouette image",
      "info": "Upload a transparent PNG or WebP. The bear is anchored to the bottom edge, above the mobile shadow layer and behind the ASTER logo, canopy and countdown."
    },
    {
      "type": "range",
      "id": "bear_opacity",
      "label": "Master opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "info": "Controls the silhouette opacity on both desktop and mobile."
    },
    {
      "type": "header",
      "content": "Desktop"
    },
    {
      "type": "range",
      "id": "bear_x_desktop",
      "label": "Horizontal position",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "bear_width_desktop_px",
      "label": "Scale (fixed width)",
      "min": 100,
      "max": 1000,
      "step": 5,
      "unit": "px",
      "default": 400,
      "info": "Fixed image width in pixels. The bottom edge stays anchored while scale determines how high the bear reaches."
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "bear_x_mobile",
      "label": "Horizontal position",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "bear_width_mobile_px",
      "label": "Scale (fixed width)",
      "min": 100,
      "max": 800,
      "step": 5,
      "unit": "px",
      "default": 390,
      "info": "Fixed image width in pixels. The bottom edge stays anchored while scale determines how high the bear reaches."
    }
  ],
  "presets": [
    {
      "name": "Bear silhouette"
    }
  ]
}
{% endschema %}
