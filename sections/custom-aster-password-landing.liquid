<script>
(() => {
  const section = document.getElementById({{ section_id | json }});
  if (!section || section.dataset.asterInitialised === 'true') return;
  section.dataset.asterInitialised = 'true';

  const background = section.querySelector('[data-aster-background]');
  const canopy = section.querySelector('[data-aster-canopy]');
  const canopyShadowLayer = section.querySelector('.aster-landing__canopy-shadow-layer');
  const canopyShadowImage = section.querySelector('[data-aster-canopy-shadow]');
  const foregroundWrap = section.querySelector('.aster-landing__foreground');
  const logoWrap = section.querySelector('[data-aster-logo]');
  const logoImage = logoWrap?.querySelector('.aster-landing__logo') || null;
  const contentWrap = section.querySelector('[data-aster-content]');
  const waitlistForm = section.querySelector('#AsterWaitingListForm');
  const waitlistButton = waitlistForm?.querySelector('[data-aster-waitlist-button]') || null;
  const submitLabel = waitlistForm?.querySelector('[data-aster-submit-label]') || null;
  const klaviyoEngine = section.querySelector('[data-aster-klaviyo-engine]');
  const klaviyoFormId = klaviyoEngine?.dataset.klaviyoFormId?.trim() || '';
  const passwordModal = section.querySelector('[data-aster-password-modal]');
  const passwordTrigger = section.querySelector('[data-aster-password-trigger]');
  const passwordClosers = section.querySelectorAll('[data-aster-password-close]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const desktopLayoutQuery = window.matchMedia('(min-width: 750px)');
  const clampNumber = (value,min,max) => Math.min(max,Math.max(min,value));
  const fallbackCanopyAspect = 1105 / 447;
  let canopyArtworkBounds={top:.14,bottom:.40,left:.18,right:.82,centreX:.5,centreY:.27};
  let logoArtworkBounds={top:.25,bottom:.75,left:.04,right:.96,centreX:.5,centreY:.5};
  let responsiveLayoutFrame=null,responsiveSecondPassFrame=null;

  const scanVisibleAlphaBounds=async(sourceImage,alphaThreshold=28)=>{if(!sourceImage)return null;const sourceUrl=sourceImage.currentSrc||sourceImage.src;if(!sourceUrl)return null;try{const probe=new Image();probe.crossOrigin='anonymous';probe.decoding='async';probe.src=sourceUrl;if(typeof probe.decode==='function'){await probe.decode()}else{await new Promise((resolve,reject)=>{probe.addEventListener('load',resolve,{once:true});probe.addEventListener('error',reject,{once:true})})}if(!probe.naturalWidth||!probe.naturalHeight)return null;const maxScanDimension=700;const scanScale=Math.min(1,maxScanDimension/Math.max(probe.naturalWidth,probe.naturalHeight));const scanWidth=Math.max(1,Math.round(probe.naturalWidth*scanScale));const scanHeight=Math.max(1,Math.round(probe.naturalHeight*scanScale));const canvas=document.createElement('canvas');canvas.width=scanWidth;canvas.height=scanHeight;const context=canvas.getContext('2d',{willReadFrequently:true});if(!context)return null;context.clearRect(0,0,scanWidth,scanHeight);context.drawImage(probe,0,0,scanWidth,scanHeight);const pixels=context.getImageData(0,0,scanWidth,scanHeight).data;const minimumRowPixels=Math.max(3,Math.round(scanWidth*.003));const minimumColumnPixels=Math.max(3,Math.round(scanHeight*.003));const rowHasArtwork=y=>{let count=0;const rowStart=y*scanWidth*4;for(let x=0;x<scanWidth;x+=1){if(pixels[rowStart+x*4+3]>=alphaThreshold){count+=1;if(count>=minimumRowPixels)return true}}return false};const columnHasArtwork=x=>{let count=0;for(let y=0;y<scanHeight;y+=1){const alpha=pixels[(y*scanWidth+x)*4+3];if(alpha>=alphaThreshold){count+=1;if(count>=minimumColumnPixels)return true}}return false};let topRow=-1,bottomRow=-1,leftColumn=-1,rightColumn=-1;for(let y=0;y<scanHeight;y+=1){if(rowHasArtwork(y)){topRow=y;break}}for(let y=scanHeight-1;y>=0;y-=1){if(rowHasArtwork(y)){bottomRow=y;break}}for(let x=0;x<scanWidth;x+=1){if(columnHasArtwork(x)){leftColumn=x;break}}for(let x=scanWidth-1;x>=0;x-=1){if(columnHasArtwork(x)){rightColumn=x;break}}if(topRow<0||bottomRow<topRow||leftColumn<0||rightColumn<leftColumn)return null;const top=topRow/scanHeight,bottom=(bottomRow+1)/scanHeight,left=leftColumn/scanWidth,right=(rightColumn+1)/scanWidth;return{top,bottom,left,right,centreX:left+(right-left)/2,centreY:top+(bottom-top)/2}}catch(error){return null}};
  const refreshArtworkBounds=async()=>{const[canopyBounds,logoBounds]=await Promise.all([scanVisibleAlphaBounds(canopy,28),scanVisibleAlphaBounds(logoImage,18)]);if(canopyBounds)canopyArtworkBounds=canopyBounds;if(logoBounds)logoArtworkBounds=logoBounds;scheduleResponsiveComposition()};
  const getArtworkRect=(image,bounds,sectionRect)=>{if(!image||!bounds)return null;const imageRect=image.getBoundingClientRect();const left=imageRect.left-sectionRect.left+imageRect.width*bounds.left;const right=imageRect.left-sectionRect.left+imageRect.width*bounds.right;const top=imageRect.top-sectionRect.top+imageRect.height*bounds.top;const bottom=imageRect.top-sectionRect.top+imageRect.height*bounds.bottom;return{left,right,top,bottom,width:right-left,height:bottom-top}};
