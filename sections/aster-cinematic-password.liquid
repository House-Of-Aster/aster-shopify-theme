    position: absolute;
    left: 0;
    width: 42px;
    height: 33px;
    overflow: hidden;
    text-align: center;
  }

  #{{ section_id }} .aster-cinematic-countdown__top,
  #{{ section_id }} .aster-cinematic-countdown__leaf-front {
    top: 0;
    line-height: 66px;
    border-radius: 8px 8px 0 0;
    background: rgba(13, 9, 9, .88);
  }

  #{{ section_id }} .aster-cinematic-countdown__bottom,
