    perspective: 220px;
    background: rgba(12, 8, 8, .52);
    box-shadow:
      0 8px 24px rgba(0, 0, 0, .12),
      inset 0 0 0 1px rgba(248, 246, 235, .10);
    -webkit-backdrop-filter: blur(5px);
    backdrop-filter: blur(5px);
  }

  #{{ section_id }} .aster-cinematic-countdown__top,
  #{{ section_id }} .aster-cinematic-countdown__bottom,
  #{{ section_id }} .aster-cinematic-countdown__leaf-front,
