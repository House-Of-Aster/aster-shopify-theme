  #{{ section_id }} .aster-cinematic-countdown__rotor {
    position: relative;
    display: block;
    width: 42px;
    height: 66px;
    overflow: hidden;
    border-radius: 8px;
    color: var(--aster-cinematic-ivory);
    font-size: 34px;
    font-weight: 500;
