    top: 7px;
    right: 9px;
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    padding: 0;
    border: 0;
    color: var(--aster-cinematic-ivory);
    font-size: 24px;
    line-height: 1;
    background: transparent;
    cursor: pointer;
  }

  #{{ section_id }} .aster-cinematic-password__errors {
    grid-column: 1 / -1;
    margin-top: 8px;
    font-size: 12px;
    line-height: 1.4;
    text-align: left;
  }

  #{{ section_id }} .aster-cinematic-password__visually-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  @media screen and (max-width: 749px) {
    #{{ section_id }} {
      min-height: 520px;
    }

    #{{ section_id }} .aster-cinematic-password__veil {
      background: rgba(27, 7, 11, .08);
    }

    #{{ section_id }} .aster-cinematic-password__content {
      top: 50%;
      left: 50%;
      right: auto;
      width: min(88vw, 390px);
      transform: translate(-50%, -50%);
    }

    #{{ section_id }} .aster-cinematic-password__eyebrow {
      margin-bottom: clamp(26px, 4.2dvh, 38px);
      font-size: 10px;
      letter-spacing: .38em;
      text-indent: .38em;
    }

    #{{ section_id }} .aster-cinematic-password__heading {
      font-size: clamp(48px, 14vw, 68px);
      line-height: .9;
    }

    #{{ section_id }} .aster-cinematic-password__rule {
      height: 28px;
      margin: clamp(22px, 3.2dvh, 30px) auto 15px;
    }

    #{{ section_id }} .aster-cinematic-password__tagline {
      font-size: 9px;
      line-height: 1.85;
      letter-spacing: .31em;
      text-indent: .31em;
    }

    #{{ section_id }} .aster-cinematic-countdown {
      gap: 8px;
      margin-top: clamp(24px, 3.5dvh, 34px);
    }

    #{{ section_id }} .aster-cinematic-countdown__label {
      margin-bottom: 5px;
      font-size: 7px;
      letter-spacing: .10em;
    }

    #{{ section_id }} .aster-cinematic-countdown__digits {
      gap: 3px;
    }

    #{{ section_id }} .aster-cinematic-countdown__rotor,
    #{{ section_id }} .aster-cinematic-countdown__leaf {
      width: 28px;
      height: 46px;
      border-radius: 6px;
    }

    #{{ section_id }} .aster-cinematic-countdown__rotor {
      font-size: 23px;
    }

    #{{ section_id }} .aster-cinematic-countdown__top,
    #{{ section_id }} .aster-cinematic-countdown__bottom,
    #{{ section_id }} .aster-cinematic-countdown__leaf-front,
    #{{ section_id }} .aster-cinematic-countdown__leaf-rear {
      width: 28px;
      height: 23px;
    }

    #{{ section_id }} .aster-cinematic-countdown__top,
    #{{ section_id }} .aster-cinematic-countdown__leaf-front {
      line-height: 46px;
      border-radius: 6px 6px 0 0;
    }

    #{{ section_id }} .aster-cinematic-countdown__bottom,
    #{{ section_id }} .aster-cinematic-countdown__leaf-rear {
      border-radius: 0 0 6px 6px;
    }

    #{{ section_id }} .aster-cinematic-countdown__leaf-rear {
      top: 23px;
    }

    #{{ section_id }} .aster-cinematic-password__access {
      right: 50%;
      bottom: max(10px, env(safe-area-inset-bottom));
      transform: translateX(50%);
      font-size: 8px;
    }

    #{{ section_id }} .aster-cinematic-password__dialog {
      padding: 34px 20px 24px;
    }

    #{{ section_id }} .aster-cinematic-password__password-form {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-height: 680px) and (min-width: 750px) {
    #{{ section_id }} .aster-cinematic-password__eyebrow {
      margin-bottom: 28px;
    }

    #{{ section_id }} .aster-cinematic-password__heading {
      font-size: clamp(48px, 3.6vw, 64px);
    }

    #{{ section_id }} .aster-cinematic-password__rule {
      height: 26px;
      margin-top: 22px;
    }

    #{{ section_id }} .aster-cinematic-countdown {
      margin-top: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ section_id }} .aster-cinematic-password__video,
    #{{ section_id }} .aster-cinematic-password__intro,
    #{{ section_id }} .aster-cinematic-countdown__leaf {
      transition: none !important;
    }
  }
</style>

<script>
  (() => {
    const section = document.getElementById({{ section_id | json }});
    if (!section) return;

    const video = section.querySelector('[data-aster-password-video]');
    const intro = section.querySelector('[data-aster-password-intro]');
    const countdown = section.querySelector('[data-aster-cinematic-countdown]');
    const rotors = Array.from(section.querySelectorAll('[data-aster-countdown-rotor]'));
    const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const mobileQuery = window.matchMedia('(max-width: 749px)');
    const targetTime = Date.parse(section.dataset.countdownTarget || '');

    let currentVideoSource = '';
    let countdownInterval = null;
    const flipTimers = new Set();

    const revealScene = () => {
      video?.classList.add('is-ready');
      section.classList.add('is-ready');
    };

    const chooseVideoSource = () => {
      if (!video) return;

      const nextSource = mobileQuery.matches
        ? video.dataset.mobileSrc
        : video.dataset.desktopSrc;

      if (!nextSource || nextSource === currentVideoSource) return;
      currentVideoSource = nextSource;

      video.pause();
      video.removeAttribute('src');
      video.load();

      const handleLoadedData = () => {
        revealScene();

        if (reducedMotionQuery.matches) {
          try {
            video.currentTime = 0.001;
          } catch (error) {
            // The first decoded frame is already a valid reduced-motion fallback.
          }
          video.pause();
          return;
        }

        video.play().catch(() => undefined);
      };

      video.addEventListener('loadeddata', handleLoadedData, { once: true });
      video.src = nextSource;
      video.load();

      if (video.readyState >= 2) {
        handleLoadedData();
      }
    };

    const pad = (value) => String(Math.max(0, value)).padStart(2, '0');

    const getCountdownDigits = () => {
      if (!Number.isFinite(targetTime)) return '00000000'.split('');

      const remaining = Math.max(0, targetTime - Date.now());
      const totalSeconds = Math.floor(remaining / 1000);
      const days = Math.min(99, Math.floor(totalSeconds / 86400));
      const hours = Math.floor((totalSeconds % 86400) / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const seconds = totalSeconds % 60;

      return `${pad(days)}${pad(hours)}${pad(minutes)}${pad(seconds)}`.split('');
    };

    const setRotorStatic = (rotor, value) => {
      rotor.dataset.value = value;
      rotor.querySelector('[data-aster-countdown-top]').textContent = value;
      rotor.querySelector('[data-aster-countdown-bottom]').textContent = value;
      rotor.querySelector('[data-aster-countdown-front]').textContent = value;
      rotor.querySelector('[data-aster-countdown-rear]').textContent = value;
    };

    const animateRotor = (rotor, nextValue) => {
      const previousValue = rotor.dataset.value ?? nextValue;
      if (previousValue === nextValue || reducedMotionQuery.matches) {
        setRotorStatic(rotor, nextValue);
        return;
      }

      const top = rotor.querySelector('[data-aster-countdown-top]');
      const bottom = rotor.querySelector('[data-aster-countdown-bottom]');
      const front = rotor.querySelector('[data-aster-countdown-front]');
      const rear = rotor.querySelector('[data-aster-countdown-rear]');
      const leaf = rotor.querySelector('[data-aster-countdown-leaf]');

      top.textContent = previousValue;
      bottom.textContent = nextValue;
      front.textContent = previousValue;
      rear.textContent = nextValue;
      leaf.classList.remove('is-flipped');
      void leaf.offsetWidth;
      leaf.classList.add('is-flipped');

      const timer = window.setTimeout(() => {
        flipTimers.delete(timer);
        setRotorStatic(rotor, nextValue);
        leaf.classList.remove('is-flipped');
      }, 520);

      flipTimers.add(timer);
    };

    const renderCountdown = (initial = false) => {
      const digits = getCountdownDigits();

      rotors.forEach((rotor, index) => {
        const value = digits[index] || '0';

        if (initial || rotor.dataset.value === undefined) {
          setRotorStatic(rotor, value);
          return;
        }

        animateRotor(rotor, value);
      });

      if (countdown) {
        const remaining = Number.isFinite(targetTime) ? Math.max(0, targetTime - Date.now()) : 0;
        countdown.setAttribute(
          'aria-label',
          remaining > 0 ? 'House of Aster launch countdown' : 'House of Aster launch countdown complete'
        );
      }
    };

    renderCountdown(true);
    countdownInterval = window.setInterval(() => renderCountdown(false), 1000);

    chooseVideoSource();

    if (typeof mobileQuery.addEventListener === 'function') {
      mobileQuery.addEventListener('change', chooseVideoSource);
    } else if (typeof mobileQuery.addListener === 'function') {
      mobileQuery.addListener(chooseVideoSource);
    }

    const trigger = section.querySelector('[data-aster-password-trigger]');
    const modal = section.querySelector('[data-aster-password-modal]');
    const closers = Array.from(section.querySelectorAll('[data-aster-password-close]'));
    let lastFocusedElement = null;

    const openModal = () => {
      if (!modal) return;
      lastFocusedElement = document.activeElement;
      modal.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      const input = modal.querySelector('input[type="password"]');
      window.requestAnimationFrame(() => input?.focus());
    };

    const closeModal = () => {
      if (!modal || modal.hidden) return;
      modal.hidden = true;
      document.documentElement.style.overflow = '';
      if (lastFocusedElement instanceof HTMLElement) {
        lastFocusedElement.focus();
      }
    };

    trigger?.addEventListener('click', openModal);
    closers.forEach((closer) => closer.addEventListener('click', closeModal));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeModal();
    });

    window.addEventListener('pagehide', () => {
      if (countdownInterval) window.clearInterval(countdownInterval);
      flipTimers.forEach((timer) => window.clearTimeout(timer));
      flipTimers.clear();
    }, { once: true });

    if (intro) {
      window.setTimeout(() => {
        if (!section.classList.contains('is-ready') && video?.readyState >= 2) {
          revealScene();
        }
      }, 2500);
    }
  })();
</script>

