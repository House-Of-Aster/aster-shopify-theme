    border-radius: 18px;
    color: var(--aster-cinematic-ivory);
    text-align: center;
    background: rgba(64, 19, 29, .72);
    box-shadow: 0 30px 80px rgba(0, 0, 0, .22);
    -webkit-backdrop-filter: blur(18px) saturate(125%);
    backdrop-filter: blur(18px) saturate(125%);
  }

  #{{ section_id }} .aster-cinematic-password__dialog-eyebrow {
    margin: 0 0 18px;
    font-size: 9px;
    letter-spacing: .34em;
    text-indent: .34em;
    opacity: .76;
  }

  #{{ section_id }} .aster-cinematic-password__dialog h2 {
    margin: 0;
    font-family: "British Poems", var(--font-display--family, serif);
    font-size: 38px;
    font-style: normal;
    font-weight: 400;
    line-height: 1;
    text-transform: none;
  }

  #{{ section_id }} .aster-cinematic-password__password-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px;
    margin-top: 24px;
  }

  #{{ section_id }} .aster-cinematic-password__password-form input,
  #{{ section_id }} .aster-cinematic-password__password-form button {
