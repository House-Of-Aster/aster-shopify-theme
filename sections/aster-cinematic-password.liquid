{% comment %}
  ASTER cinematic password / pre-launch landing.
  Full-screen Shopify-hosted video, editorial lock-up, signed-off FlipDown countdown,
  scheduled Klaviyo signup handoff, and preserved storefront-password access.
{% endcomment %}

{% liquid
  assign section_id = 'AsterCinematicPassword-' | append: section.id
  assign desktop_video_url = 'https://cdn.shopify.com/videos/c/o/v/69d9c943c65c485391766e68feba94a2.mp4'
  assign mobile_video_url = desktop_video_url
  assign signup_preview = false
  if request.design_mode and section.settings.preview_signup_in_editor
    assign signup_preview = true
  endif
%}

<section
  id="{{ section_id }}"
  class="aster-cinematic-password"
  data-aster-cinematic-password
  data-countdown-target="2026-11-01T09:00:00Z"
  data-signup-target="2026-11-01T09:00:00Z"
  data-signup-configured="{% if section.settings.klaviyo_embed != blank %}true{% else %}false{% endif %}"
  data-signup-editor-preview="{% if signup_preview %}true{% else %}false{% endif %}"
>
  <div class="aster-cinematic-password__media" aria-hidden="true">
    <video
      class="aster-cinematic-password__video"
      data-aster-password-video
      data-desktop-src="{{ desktop_video_url }}"
      data-mobile-src="{{ mobile_video_url }}"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
    ></video>
    <div class="aster-cinematic-password__veil"></div>
  </div>

  <div class="aster-cinematic-password__intro" data-aster-password-intro aria-hidden="true"></div>

  <div class="aster-cinematic-password__content">
    <div class="aster-cinematic-password__panel">
      <p class="aster-cinematic-password__eyebrow">THE HOUSE OF ASTER</p>

      <h1 class="aster-cinematic-password__heading">
        For your eyes,<br>
        <em>mostly.</em>
      </h1>

      <span class="aster-cinematic-password__rule" aria-hidden="true"></span>

      <p class="aster-cinematic-password__tagline">
        SOME THINGS ARE WORTH<br>
        KEEPING TO YOURSELF.
      </p>

      <div
        class="aster-flipdown"
        data-aster-flipdown
        role="timer"
        aria-label="House of Aster launch countdown"
      >
        {% assign countdown_groups = 'Days,Hours,Minutes,Seconds' | split: ',' %}
        {% for group_label in countdown_groups %}
          <div class="aster-flipdown__group">
            <div class="aster-flipdown__heading">{{ group_label }}</div>
            {% for digit_index in (1..2) %}
              <div class="aster-flipdown__rotor">
                <div class="aster-flipdown__rotor-leaf" data-aster-rotor-leaf>
                  <figure class="aster-flipdown__rotor-leaf-rear" data-aster-rotor-rear>0</figure>
                  <figure class="aster-flipdown__rotor-leaf-front" data-aster-rotor-front>0</figure>
                </div>
                <div class="aster-flipdown__rotor-top" data-aster-rotor-top>0</div>
                <div class="aster-flipdown__rotor-bottom" data-aster-rotor-bottom>0</div>
              </div>
            {% endfor %}
          </div>
        {% endfor %}
      </div>

      <div
        class="aster-cinematic-password__signup"
        data-aster-signup
        hidden
      >
        {% if section.settings.klaviyo_embed != blank %}
          {{ section.settings.klaviyo_embed }}
        {% elsif request.design_mode %}
          <div class="aster-cinematic-password__signup-empty">
            Paste the Klaviyo embed DIV into this section's settings to preview the form here.
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  <button
    class="aster-cinematic-password__access"
    type="button"
    data-aster-password-trigger
    aria-haspopup="dialog"
    aria-controls="AsterPasswordModal-{{ section.id }}"
  >
    Store access
  </button>

  <div
    class="aster-cinematic-password__modal"
    id="AsterPasswordModal-{{ section.id }}"
    data-aster-password-modal
    hidden
  >
    <button
      class="aster-cinematic-password__modal-backdrop"
      type="button"
      aria-label="Close password form"
      data-aster-password-close
    ></button>

    <div
      class="aster-cinematic-password__dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="AsterPasswordTitle-{{ section.id }}"
    >
      <button
        class="aster-cinematic-password__modal-close"
        type="button"
        aria-label="Close password form"
        data-aster-password-close
      >
        ×
      </button>

      <p class="aster-cinematic-password__dialog-eyebrow">THE HOUSE OF ASTER</p>
      <h2 id="AsterPasswordTitle-{{ section.id }}">Enter store password</h2>

      {% form 'storefront_password', class: 'aster-cinematic-password__password-form' %}
        <label class="aster-cinematic-password__visually-hidden" for="AsterPassword-{{ section.id }}">
          Password
        </label>
        <input
          id="AsterPassword-{{ section.id }}"
          type="password"
          name="password"
          placeholder="Password"
          autocomplete="current-password"
        >
        <button type="submit">Enter</button>
        {% if form.errors %}
          <div class="aster-cinematic-password__errors">{{ form.errors | default_errors }}</div>
        {% endif %}
      {% endform %}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} {
    display: contents;
  }

  #{{ section_id }} {
    --aster-cinematic-ivory: #f8f6eb;
    --aster-cinematic-red: #a52d34;
    --aster-cinematic-wine: #6b2331;
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100svh;
    height: 100dvh;
    min-height: 560px;
    overflow: hidden;
    isolation: isolate;
    background: var(--aster-cinematic-red);
    color: var(--aster-cinematic-ivory);
  }

  #{{ section_id }} *,
  #{{ section_id }} *::before,
  #{{ section_id }} *::after {
    box-sizing: border-box;
  }

  #{{ section_id }} .aster-cinematic-password__media,
  #{{ section_id }} .aster-cinematic-password__video,
  #{{ section_id }} .aster-cinematic-password__veil,
  #{{ section_id }} .aster-cinematic-password__intro {
    position: absolute;
    inset: 0;
  }

  #{{ section_id }} .aster-cinematic-password__media {
    z-index: 0;
    background: var(--aster-cinematic-wine);
  }

  #{{ section_id }} .aster-cinematic-password__video {
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
    object-position: center center;
    opacity: 0;
    transition: opacity 650ms cubic-bezier(.22, 1, .36, 1);
  }

  #{{ section_id }} .aster-cinematic-password__video.is-ready {
    opacity: 1;
  }

  #{{ section_id }} .aster-cinematic-password__veil {
    pointer-events: none;
    background:
      linear-gradient(
        90deg,
        rgba(22, 7, 8, 0) 0%,
        rgba(22, 7, 8, 0) 48%,
        rgba(22, 7, 8, .05) 62%,
        rgba(22, 7, 8, .16) 100%
      );
  }

  #{{ section_id }} .aster-cinematic-password__intro {
    z-index: 20;
    background: var(--aster-cinematic-red);
    opacity: 1;
    pointer-events: none;
    transition: opacity 700ms cubic-bezier(.22, 1, .36, 1);
  }

  #{{ section_id }}.is-ready .aster-cinematic-password__intro {
    opacity: 0;
  }

  #{{ section_id }} .aster-cinematic-password__content {
    position: absolute;
    z-index: 5;
    top: 50%;
    right: clamp(76px, 10vw, 210px);
    width: min(34vw, 560px);
    transform: translateY(-50%);
    text-align: center;
  }

  #{{ section_id }} .aster-cinematic-password__panel {
    width: 100%;
    margin: 0 auto;
  }

  #{{ section_id }} .aster-cinematic-password__eyebrow,
  #{{ section_id }} .aster-cinematic-password__tagline,
  #{{ section_id }} .aster-cinematic-password__dialog-eyebrow,
  #{{ section_id }} .aster-cinematic-password__access {
    font-family: var(--font-body--family, Arial, sans-serif);
    font-style: normal;
    font-weight: 400;
    text-transform: uppercase;
  }

  #{{ section_id }} .aster-cinematic-password__eyebrow {
    margin: 0 0 clamp(38px, 4.2vh, 56px);
    font-size: clamp(11px, .78vw, 14px);
    line-height: 1.2;
    letter-spacing: .52em;
    text-indent: .52em;
  }

  #{{ section_id }} .aster-cinematic-password__heading {
    margin: 0;
    color: var(--aster-cinematic-ivory);
    font-family: "British Poems", var(--font-display--family, serif);
    font-size: clamp(54px, 4vw, 76px);
    font-style: normal;
    font-weight: 400;
    line-height: .92;
    letter-spacing: -.018em;
    text-transform: none;
    text-wrap: balance;
    text-shadow: 0 2px 22px rgba(24, 5, 8, .18);
  }

  #{{ section_id }} .aster-cinematic-password__heading em {
    display: inline-block;
    font-style: italic;
    font-weight: inherit;
  }

  #{{ section_id }} .aster-cinematic-password__rule {
    display: block;
    width: 1px;
    height: 34px;
    margin: clamp(26px, 3vh, 38px) auto 18px;
    background: rgba(248, 246, 235, .68);
  }

  #{{ section_id }} .aster-cinematic-password__tagline {
    margin: 0;
    font-size: clamp(10px, .72vw, 13px);
    line-height: 1.85;
    letter-spacing: .42em;
    text-indent: .42em;
    text-shadow: 0 2px 16px rgba(24, 5, 8, .18);
  }

  /* Signed-off ASTER countdown treatment, ported 1:1 from the original password page. */
  #{{ section_id }} .aster-flipdown {
    position: relative;
    z-index: 6;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    width: 100%;
    margin: 18px auto 0;
    color: #e6d3bd;
    font-family: var(--font-body--family, Arial, sans-serif);
    font-variant-numeric: tabular-nums;
    pointer-events: none;
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 260ms cubic-bezier(.22, 1, .36, 1),
      transform 260ms cubic-bezier(.22, 1, .36, 1);
  }

  #{{ section_id }} .aster-flipdown.is-leaving {
    opacity: 0;
    transform: translateY(-6px);
  }

  #{{ section_id }} .aster-flipdown[hidden] {
    display: none;
  }

  #{{ section_id }} .aster-flipdown__group {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px;
    padding-right: clamp(16px, 3vw, 28px);
  }

  #{{ section_id }} .aster-flipdown__group:last-child {
    padding-right: 0;
  }

  #{{ section_id }} .aster-flipdown__heading {
    flex: 0 0 100%;
    height: 24px;
    color: #e6d3bd;
    font: inherit;
    font-size: 10px;
    font-weight: 500;
    line-height: 24px;
    letter-spacing: .11em;
    text-align: center;
    text-transform: uppercase;
    opacity: .58;
  }

  #{{ section_id }} .aster-flipdown__group:nth-child(2)::before,
  #{{ section_id }} .aster-flipdown__group:nth-child(2)::after,
  #{{ section_id }} .aster-flipdown__group:nth-child(3)::before,
  #{{ section_id }} .aster-flipdown__group:nth-child(3)::after {
    content: '';
    position: absolute;
    right: calc(clamp(16px, 3vw, 28px) / 2 - 2px);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: rgba(230, 211, 189, .48);
  }

  #{{ section_id }} .aster-flipdown__group:nth-child(2)::before,
  #{{ section_id }} .aster-flipdown__group:nth-child(3)::before {
    top: 45px;
  }

  #{{ section_id }} .aster-flipdown__group:nth-child(2)::after,
  #{{ section_id }} .aster-flipdown__group:nth-child(3)::after {
    top: 62px;
  }

  #{{ section_id }} .aster-flipdown__rotor {
    --aster-rotor-top-bg: rgb(12, 12, 9);
    --aster-rotor-bottom-bg: rgb(19, 12, 10);
    position: relative;
    width: 42px;
    height: 66px;
    border-radius: 8px;
    color: #e6d3bd;
    font: inherit;
    font-size: 34px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    text-align: center;
    perspective: 220px;
    background: rgba(7, 12, 8, .47);
    box-shadow:
      0 8px 24px rgba(0, 0, 0, .10),
      inset 0 0 0 1px rgba(230, 211, 189, .10);
  }

  #{{ section_id }} .aster-flipdown__rotor-top,
  #{{ section_id }} .aster-flipdown__rotor-bottom {
    position: absolute;
    overflow: hidden;
    left: 0;
    width: 42px;
    height: 33px;
  }

  #{{ section_id }} .aster-flipdown__rotor-top {
    top: 0;
    z-index: 0;
    line-height: 66px;
    border-radius: 8px 8px 0 0;
    background: var(--aster-rotor-top-bg);
  }

  #{{ section_id }} .aster-flipdown__rotor-bottom {
    bottom: 0;
    z-index: 0;
    line-height: 0;
    border-radius: 0 0 8px 8px;
    background: var(--aster-rotor-bottom-bg);
  }

  #{{ section_id }} .aster-flipdown__rotor-leaf {
    position: absolute;
    z-index: 4;
    top: 0;
    left: 0;
    width: 42px;
    height: 66px;
    transform: rotateX(0deg);
    transform-style: preserve-3d;
    transition: transform 0s;
    will-change: transform;
  }

  #{{ section_id }} .aster-flipdown__rotor-leaf.is-flipped {
    transform: rotateX(-180deg);
    transition: transform 500ms ease-in-out;
  }

  #{{ section_id }} .aster-flipdown__rotor-leaf-front,
  #{{ section_id }} .aster-flipdown__rotor-leaf-rear {
    position: absolute;
    overflow: hidden;
    left: 0;
    top: 0;
    width: 42px;
    height: 33px;
    margin: 0;
    color: #e6d3bd;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  #{{ section_id }} .aster-flipdown__rotor-leaf-front {
    line-height: 66px;
    border-radius: 8px 8px 0 0;
    background: var(--aster-rotor-top-bg);
    transform: rotateX(0deg) translateZ(.15px);
  }

  #{{ section_id }} .aster-flipdown__rotor-leaf-rear {
    line-height: 0;
    border-radius: 0 0 8px 8px;
    background: var(--aster-rotor-bottom-bg);
    transform: rotateX(-180deg) translateZ(.15px);
  }

  #{{ section_id }} .aster-flipdown__rotor::after {
    content: '';
    position: absolute;
    z-index: 6;
    bottom: 0;
    left: 0;
    width: 42px;
    height: 33px;
    border-top: 1px solid rgba(230, 211, 189, .10);
    border-radius: 0 0 8px 8px;
    pointer-events: none;
  }

  #{{ section_id }} .aster-cinematic-password__signup[hidden] {
    display: none;
  }

  #{{ section_id }} .aster-cinematic-password__signup {
    width: 100%;
    margin: 22px auto 0;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 420ms cubic-bezier(.22, 1, .36, 1),
      transform 420ms cubic-bezier(.22, 1, .36, 1);
  }

  #{{ section_id }} .aster-cinematic-password__signup.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  #{{ section_id }} .aster-cinematic-password__signup > * {
    width: 100%;
    max-width: 100%;
  }

  #{{ section_id }} .aster-cinematic-password__signup-empty {
    width: 100%;
    padding: 16px 18px;
    border-radius: 12px;
    color: rgba(248, 246, 235, .78);
    font-family: var(--font-body--family, Arial, sans-serif);
    font-size: 11px;
    line-height: 1.5;
    letter-spacing: .04em;
    text-align: center;
    background: rgba(248, 246, 235, .08);
  }

  #{{ section_id }} .aster-cinematic-password__access {
    position: absolute;
    z-index: 7;
    right: 24px;
    bottom: max(20px, env(safe-area-inset-bottom));
    min-width: 44px;
    min-height: 44px;
    padding: 12px 0;
    border: 0;
    color: rgba(248, 246, 235, .72);
    font-size: 9px;
    line-height: 1;
    letter-spacing: .22em;
    background: transparent;
    cursor: pointer;
  }

  #{{ section_id }} .aster-cinematic-password__access:hover,
  #{{ section_id }} .aster-cinematic-password__access:focus-visible {
    color: var(--aster-cinematic-ivory);
  }

  #{{ section_id }} .aster-cinematic-password__modal[hidden] {
    display: none;
  }

  #{{ section_id }} .aster-cinematic-password__modal {
    position: fixed;
    z-index: 50;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 24px;
  }

  #{{ section_id }} .aster-cinematic-password__modal-backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: rgba(31, 7, 12, .72);
    cursor: pointer;
  }

  #{{ section_id }} .aster-cinematic-password__dialog {
    position: relative;
    z-index: 1;
    width: min(420px, 100%);
    padding: 36px;
    border-radius: 18px;
    color: var(--aster-cinematic-ivory);
    text-align: center;
    background: rgba(64, 19, 29, .72);
    box-shadow: 0 30px 80px rgba(0, 0, 0, .22);
    -webkit-backdrop-filter: blur(18px) saturate(125%);
    backdrop-filter: blur(18px) saturate(125%);
  }

  #{{ section_id }} .aster-cinematic-password__dialog-eyebrow {
    margin: 0 0 18px;
    font-size: 9px;
    letter-spacing: .34em;
    text-indent: .34em;
    opacity: .76;
  }

  #{{ section_id }} .aster-cinematic-password__dialog h2 {
    margin: 0;
    font-family: "British Poems", var(--font-display--family, serif);
    font-size: 38px;
    font-style: normal;
    font-weight: 400;
    line-height: 1;
    text-transform: none;
  }

  #{{ section_id }} .aster-cinematic-password__password-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px;
    margin-top: 24px;
  }

  #{{ section_id }} .aster-cinematic-password__password-form input,
  #{{ section_id }} .aster-cinematic-password__password-form button {
    min-height: 50px;
    border: 0;
    border-radius: 12px;
    font: inherit;
  }

  #{{ section_id }} .aster-cinematic-password__password-form input {
    min-width: 0;
    padding: 0 16px;
    color: var(--aster-cinematic-ivory);
    background: rgba(248, 246, 235, .10);
    outline: 1px solid rgba(248, 246, 235, .14);
    outline-offset: -1px;
  }

  #{{ section_id }} .aster-cinematic-password__password-form input::placeholder {
    color: rgba(248, 246, 235, .58);
  }

  #{{ section_id }} .aster-cinematic-password__password-form input:focus-visible {
    outline: 2px solid rgba(248, 246, 235, .74);
    outline-offset: 1px;
  }

  #{{ section_id }} .aster-cinematic-password__password-form button {
    padding: 0 20px;
    color: var(--aster-cinematic-wine);
    background: var(--aster-cinematic-ivory);
    cursor: pointer;
  }

  #{{ section_id }} .aster-cinematic-password__modal-close {
    position: absolute;
    top: 7px;
    right: 9px;
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    padding: 0;
    border: 0;
    color: var(--aster-cinematic-ivory);
    font-size: 24px;
    line-height: 1;
    background: transparent;
    cursor: pointer;
  }

  #{{ section_id }} .aster-cinematic-password__errors {
    grid-column: 1 / -1;
    margin-top: 8px;
    font-size: 12px;
    line-height: 1.4;
    text-align: left;
  }

  #{{ section_id }} .aster-cinematic-password__visually-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  @media screen and (max-width: 749px) {
    #{{ section_id }} {
      min-height: 520px;
    }

    #{{ section_id }} .aster-cinematic-password__video {
      object-position: {{ section.settings.mobile_video_position_x }}% center;
    }

    #{{ section_id }} .aster-cinematic-password__veil {
      background: rgba(27, 7, 11, .08);
    }

    #{{ section_id }} .aster-cinematic-password__content {
      top: 50%;
      left: 50%;
      right: auto;
      width: min(88vw, 390px);
      transform: translate(-50%, -50%);
    }

    #{{ section_id }} .aster-cinematic-password__eyebrow {
      margin-bottom: clamp(26px, 4.2dvh, 38px);
      font-size: 10px;
      letter-spacing: .38em;
      text-indent: .38em;
    }

    #{{ section_id }} .aster-cinematic-password__heading {
      font-size: clamp(48px, 14vw, 68px);
      line-height: .9;
    }

    #{{ section_id }} .aster-cinematic-password__rule {
      height: 28px;
      margin: clamp(22px, 3.2dvh, 30px) auto 15px;
    }

    #{{ section_id }} .aster-cinematic-password__tagline {
      font-size: 9px;
      line-height: 1.85;
      letter-spacing: .31em;
      text-indent: .31em;
    }

    #{{ section_id }} .aster-flipdown {
      margin-top: clamp(14px, 2dvh, 18px);
    }

    #{{ section_id }} .aster-cinematic-password__signup {
      margin-top: 18px;
    }

    #{{ section_id }} .aster-flipdown__group {
      gap: 3px;
      padding-right: 12px;
    }

    #{{ section_id }} .aster-flipdown__group:nth-child(2)::before,
    #{{ section_id }} .aster-flipdown__group:nth-child(2)::after,
    #{{ section_id }} .aster-flipdown__group:nth-child(3)::before,
    #{{ section_id }} .aster-flipdown__group:nth-child(3)::after {
      right: 4px;
      width: 3px;
      height: 3px;
    }

    #{{ section_id }} .aster-flipdown__group:nth-child(2)::before,
    #{{ section_id }} .aster-flipdown__group:nth-child(3)::before {
      top: 37px;
    }

    #{{ section_id }} .aster-flipdown__group:nth-child(2)::after,
    #{{ section_id }} .aster-flipdown__group:nth-child(3)::after {
      top: 51px;
    }

    #{{ section_id }} .aster-flipdown__heading {
      height: 20px;
      font-size: 8px;
      line-height: 20px;
    }

    #{{ section_id }} .aster-flipdown__rotor,
    #{{ section_id }} .aster-flipdown__rotor-leaf {
      width: 30px;
      height: 50px;
      border-radius: 6px;
    }

    #{{ section_id }} .aster-flipdown__rotor {
      font-size: 25px;
    }

    #{{ section_id }} .aster-flipdown__rotor-top,
    #{{ section_id }} .aster-flipdown__rotor-bottom,
    #{{ section_id }} .aster-flipdown__rotor-leaf-front,
    #{{ section_id }} .aster-flipdown__rotor-leaf-rear {
      width: 30px;
      height: 25px;
    }

    #{{ section_id }} .aster-flipdown__rotor-top,
    #{{ section_id }} .aster-flipdown__rotor-leaf-front {
      line-height: 50px;
      border-radius: 6px 6px 0 0;
    }

    #{{ section_id }} .aster-flipdown__rotor-bottom,
    #{{ section_id }} .aster-flipdown__rotor-leaf-rear {
      border-radius: 0 0 6px 6px;
    }

    #{{ section_id }} .aster-flipdown__rotor::after {
      width: 30px;
      height: 25px;
      border-radius: 0 0 6px 6px;
    }

    #{{ section_id }} .aster-cinematic-password__access {
      right: 50%;
      bottom: max(10px, env(safe-area-inset-bottom));
      transform: translateX(50%);
      font-size: 8px;
    }

    #{{ section_id }} .aster-cinematic-password__dialog {
      padding: 34px 20px 24px;
    }

    #{{ section_id }} .aster-cinematic-password__password-form {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-height: 680px) and (min-width: 750px) {
    #{{ section_id }} .aster-cinematic-password__eyebrow {
      margin-bottom: 28px;
    }

    #{{ section_id }} .aster-cinematic-password__heading {
      font-size: clamp(48px, 3.6vw, 64px);
    }

    #{{ section_id }} .aster-cinematic-password__rule {
      height: 26px;
      margin-top: 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ section_id }} .aster-cinematic-password__video,
    #{{ section_id }} .aster-cinematic-password__intro,
    #{{ section_id }} .aster-flipdown,
    #{{ section_id }} .aster-cinematic-password__signup,
    #{{ section_id }} .aster-flipdown__rotor-leaf,
    #{{ section_id }} .aster-flipdown__rotor-leaf.is-flipped {
      transition: none !important;
    }
  }
</style>

<script>
  (() => {
    const section = document.getElementById({{ section_id | json }});
    if (!section) return;

    const video = section.querySelector('[data-aster-password-video]');
    const intro = section.querySelector('[data-aster-password-intro]');
    const countdown = section.querySelector('[data-aster-flipdown]');
    const signup = section.querySelector('[data-aster-signup]');
    const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const targetTime = Date.parse(section.dataset.countdownTarget || '');
    const signupTargetTime = Date.parse(section.dataset.signupTarget || '');
    const signupConfigured = section.dataset.signupConfigured === 'true';
    const signupEditorPreview = section.dataset.signupEditorPreview === 'true';

    let countdownInterval = null;
    let previousDigits = [];
    let signupActivated = false;
    let signupTransitionTimer = null;
    const flipTimers = new Set();

    const revealScene = () => {
      video?.classList.add('is-ready');
      section.classList.add('is-ready');
    };

    const loadVideo = () => {
      if (!video) return;

      const source = video.dataset.desktopSrc;
      if (!source) return;

      const handleLoadedData = () => {
        revealScene();

        if (reducedMotionQuery.matches) {
          try {
            video.currentTime = 0.001;
          } catch (error) {
            // The first decoded frame is already a valid reduced-motion fallback.
          }
          video.pause();
          return;
        }

        video.play().catch(() => undefined);
      };

      video.addEventListener('loadeddata', handleLoadedData, { once: true });
      video.src = source;
      video.load();

      if (video.readyState >= 2) {
        handleLoadedData();
      }
    };

    const activateSignup = (immediate = false) => {
      if (!signup || signupActivated) return;
      if (!signupConfigured && !signupEditorPreview) return;

      signupActivated = true;

      const revealSignup = () => {
        signup.hidden = false;
        window.requestAnimationFrame(() => signup.classList.add('is-visible'));
      };

      if (!countdown || immediate || reducedMotionQuery.matches) {
        if (countdown) countdown.hidden = true;
        revealSignup();
        return;
      }

      countdown.classList.add('is-leaving');
      signupTransitionTimer = window.setTimeout(() => {
        countdown.hidden = true;
        revealSignup();
        signupTransitionTimer = null;
      }, 270);
    };

    const pad = (value, length = 2) => String(Math.max(0, value)).padStart(length, '0');

    const getClockState = () => {
      const remaining = Number.isFinite(targetTime) ? Math.max(0, targetTime - Date.now()) : 0;
      const totalSeconds = Math.floor(remaining / 1000);
      const days = Math.floor(totalSeconds / 86400);
      const hours = Math.floor((totalSeconds % 86400) / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const seconds = totalSeconds % 60;

      return {
        remaining,
        days,
        hours,
        minutes,
        seconds,
        digits: `${pad(days)}${pad(hours)}${pad(minutes)}${pad(seconds)}`.split('')
      };
    };

    const getRotors = () => {
      if (!countdown) return [];
      return Array.from(countdown.querySelectorAll('.aster-flipdown__rotor'));
    };

    const getRotorFaces = (rotor) => ({
      leaf: rotor.querySelector('[data-aster-rotor-leaf]'),
      front: rotor.querySelector('[data-aster-rotor-front]'),
      rear: rotor.querySelector('[data-aster-rotor-rear]'),
      top: rotor.querySelector('[data-aster-rotor-top]'),
      bottom: rotor.querySelector('[data-aster-rotor-bottom]')
    });

    const setRotorInstant = (rotor, value) => {
      const faces = getRotorFaces(rotor);
      if (!faces.leaf || !faces.front || !faces.rear || !faces.top || !faces.bottom) return;

      faces.leaf.classList.remove('is-flipped');
      faces.front.textContent = value;
      faces.rear.textContent = value;
      faces.top.textContent = value;
      faces.bottom.textContent = value;
    };

    const flipRotor = (rotor, previousValue, nextValue) => {
      if (previousValue === nextValue) return;

      const faces = getRotorFaces(rotor);
      if (!faces.leaf || !faces.front || !faces.rear || !faces.top || !faces.bottom) return;

      if (reducedMotionQuery.matches) {
        setRotorInstant(rotor, nextValue);
        return;
      }

      faces.leaf.classList.remove('is-flipped');
      faces.front.textContent = previousValue;
      faces.top.textContent = previousValue;
      faces.bottom.textContent = previousValue;
      faces.rear.textContent = nextValue;

      void faces.leaf.offsetWidth;

      requestAnimationFrame(() => {
        faces.leaf.classList.add('is-flipped');

        const revealTopTimer = window.setTimeout(() => {
          faces.top.textContent = nextValue;
          window.clearTimeout(revealTopTimer);
          flipTimers.delete(revealTopTimer);
        }, 210);

        const settleTimer = window.setTimeout(() => {
          faces.front.textContent = nextValue;
          faces.top.textContent = nextValue;
          faces.bottom.textContent = nextValue;
          faces.rear.textContent = nextValue;
          faces.leaf.classList.remove('is-flipped');
          window.clearTimeout(settleTimer);
          flipTimers.delete(settleTimer);
        }, 510);

        flipTimers.add(revealTopTimer);
        flipTimers.add(settleTimer);
      });
    };

    const renderCountdown = (initial = false) => {
      if (!countdown) return;

      const state = getClockState();
      const rotors = getRotors();

      state.digits.forEach((digit, index) => {
        const rotor = rotors[index];
        if (!rotor) return;

        const previous = previousDigits[index] ?? digit;

        if (initial) {
          setRotorInstant(rotor, digit);
        } else if (previous !== digit) {
          flipRotor(rotor, previous, digit);
        }
      });

      previousDigits = state.digits.slice();

      countdown.setAttribute(
        'aria-label',
        state.remaining > 0
          ? `House of Aster launches in ${state.days} days, ${state.hours} hours, ${state.minutes} minutes and ${state.seconds} seconds`
          : 'House of Aster launch countdown complete'
      );

      if (
        state.remaining <= 0 &&
        signupConfigured &&
        Number.isFinite(signupTargetTime) &&
        Date.now() >= signupTargetTime
      ) {
        activateSignup(false);
        if (countdownInterval) {
          window.clearInterval(countdownInterval);
          countdownInterval = null;
        }
      }
    };

    const shouldPreviewSignup = signupEditorPreview;
    const shouldShowScheduledSignup =
      signupConfigured && Number.isFinite(signupTargetTime) && Date.now() >= signupTargetTime;

    if (shouldPreviewSignup || shouldShowScheduledSignup) {
      activateSignup(true);
    } else {
      renderCountdown(true);
      countdownInterval = window.setInterval(() => renderCountdown(false), 1000);
    }

    loadVideo();

    const trigger = section.querySelector('[data-aster-password-trigger]');
    const modal = section.querySelector('[data-aster-password-modal]');
    const closers = Array.from(section.querySelectorAll('[data-aster-password-close]'));
    let lastFocusedElement = null;

    const openModal = () => {
      if (!modal) return;
      lastFocusedElement = document.activeElement;
      modal.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      const input = modal.querySelector('input[type="password"]');
      window.requestAnimationFrame(() => input?.focus());
    };

    const closeModal = () => {
      if (!modal || modal.hidden) return;
      modal.hidden = true;
      document.documentElement.style.overflow = '';
      if (lastFocusedElement instanceof HTMLElement) {
        lastFocusedElement.focus();
      }
    };

    trigger?.addEventListener('click', openModal);
    closers.forEach((closer) => closer.addEventListener('click', closeModal));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeModal();
    });

    window.addEventListener('pagehide', () => {
      if (countdownInterval) window.clearInterval(countdownInterval);
      if (signupTransitionTimer) window.clearTimeout(signupTransitionTimer);
      flipTimers.forEach((timer) => window.clearTimeout(timer));
      flipTimers.clear();
    }, { once: true });

    if (intro) {
      window.setTimeout(() => {
        if (!section.classList.contains('is-ready') && video?.readyState >= 2) {
          revealScene();
        }
      }, 2500);
    }
  })();
</script>

