    transform-style: preserve-3d;
    transform-origin: 50% 50%;
    transition: transform 500ms ease-in-out;
    will-change: transform;
  }

  #{{ section_id }} .aster-cinematic-countdown__leaf.is-flipped {
    transform: rotateX(-180deg);
  }

  #{{ section_id }} .aster-cinematic-countdown__leaf-front,
  #{{ section_id }} .aster-cinematic-countdown__leaf-rear {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  #{{ section_id }} .aster-cinematic-countdown__leaf-front {
    transform: rotateX(0deg) translateZ(.15px);
  }

  #{{ section_id }} .aster-cinematic-countdown__leaf-rear {
    top: 33px;
    bottom: auto;
    transform: rotateX(-180deg) translateZ(.15px);
  }

  #{{ section_id }} .aster-cinematic-countdown__rotor::after {
    content: "";
    position: absolute;
    z-index: 5;
    left: 0;
    top: 50%;
    width: 100%;
    border-top: 1px solid rgba(248, 246, 235, .10);
    pointer-events: none;
  }

  #{{ section_id }} .aster-cinematic-password__access {
    position: absolute;
    z-index: 7;
    right: 24px;
    bottom: max(20px, env(safe-area-inset-bottom));
    min-width: 44px;
    min-height: 44px;
    padding: 12px 0;
    border: 0;
    color: rgba(248, 246, 235, .72);
    font-size: 9px;
    line-height: 1;
    letter-spacing: .22em;
    background: transparent;
    cursor: pointer;
  }

  #{{ section_id }} .aster-cinematic-password__access:hover,
  #{{ section_id }} .aster-cinematic-password__access:focus-visible {
    color: var(--aster-cinematic-ivory);
  }

  #{{ section_id }} .aster-cinematic-password__modal[hidden] {
    display: none;
  }

  #{{ section_id }} .aster-cinematic-password__modal {
    position: fixed;
    z-index: 50;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 24px;
  }

  #{{ section_id }} .aster-cinematic-password__modal-backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: rgba(31, 7, 12, .72);
    cursor: pointer;
  }

  #{{ section_id }} .aster-cinematic-password__dialog {
    position: relative;
    z-index: 1;
    width: min(420px, 100%);
