<div
  id="AsterCountdownGate-{{ section.id }}"
  class="aster-countdown-controller"
  data-aster-countdown-controller
  data-enabled="{{ section.settings.show_countdown_gate }}"
  data-target="2026-11-01T09:00:00Z"
  aria-hidden="true"
></div>

<style>
  #shopify-section-{{ section.id }} {
    display: contents;
  }

  .aster-landing.aster-countdown-gate--active #AsterWaitingListForm,
  .aster-landing.aster-countdown-gate--active .aster-landing__privacy,
  .aster-landing.aster-countdown-gate--active .aster-landing__supporting {
    display: none !important;
  }

  .aster-flipdown {
    position: relative;
    z-index: 6;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    width: 100%;
    margin: 18px auto 0;
    color: #e6d3bd;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 320ms ease,
      visibility 0s linear 320ms;
  }

  .aster-landing.aster-countdown-gate--active .aster-flipdown {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 380ms ease,
      visibility 0s linear 0s;
  }

  .aster-flipdown.is-releasing {
    opacity: 0 !important;
    visibility: hidden !important;
    transition:
      opacity 300ms ease,
      visibility 0s linear 300ms !important;
  }

  .aster-flipdown__group {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px;
    padding-right: clamp(16px, 3vw, 28px);
  }

  .aster-flipdown__group:last-child {
    padding-right: 0;
  }

  .aster-flipdown__heading {
    flex: 0 0 100%;
    height: 24px;
    color: #e6d3bd;
    font: inherit;
    font-size: 10px;
    font-weight: 500;
    line-height: 24px;
    letter-spacing: .11em;
    text-align: center;
    text-transform: uppercase;
    opacity: .58;
  }

  .aster-flipdown__group:nth-child(2)::before,
  .aster-flipdown__group:nth-child(2)::after,
  .aster-flipdown__group:nth-child(3)::before,
  .aster-flipdown__group:nth-child(3)::after {
    content: '';
    position: absolute;
    right: calc(clamp(16px, 3vw, 28px) / 2 - 2px);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: rgba(230, 211, 189, .48);
  }

  .aster-flipdown__group:nth-child(2)::before,
  .aster-flipdown__group:nth-child(3)::before {
    top: 45px;
  }

  .aster-flipdown__group:nth-child(2)::after,
  .aster-flipdown__group:nth-child(3)::after {
    top: 62px;
  }

  .aster-flipdown__rotor {
    --aster-rotor-top-bg: rgb(12, 12, 9);
    --aster-rotor-bottom-bg: rgb(19, 12, 10);
    position: relative;
    width: 42px;
    height: 66px;
    border-radius: 8px;
    color: #e6d3bd;
    font: inherit;
    font-size: 34px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    text-align: center;
    perspective: 220px;
    background: rgba(7, 12, 8, .47);
    box-shadow:
      0 8px 24px rgba(0, 0, 0, .10),
      inset 0 0 0 1px rgba(230, 211, 189, .10);
  }

  .aster-flipdown__rotor-top,
  .aster-flipdown__rotor-bottom {
    position: absolute;
    overflow: hidden;
    left: 0;
    width: 42px;
    height: 33px;
  }

  .aster-flipdown__rotor-top {
    top: 0;
    z-index: 0;
    line-height: 66px;
    border-radius: 8px 8px 0 0;
    background: var(--aster-rotor-top-bg);
  }

  .aster-flipdown__rotor-bottom {
    bottom: 0;
    z-index: 0;
    line-height: 0;
    border-radius: 0 0 8px 8px;
    background: var(--aster-rotor-bottom-bg);
  }

  .aster-flipdown__rotor-leaf {
    position: absolute;
    z-index: 4;
    top: 0;
    left: 0;
    width: 42px;
    height: 66px;
    transform: rotateX(0deg);
    transform-style: preserve-3d;
    transition: transform 0s;
    will-change: transform;
  }

  .aster-flipdown__rotor-leaf.is-flipped {
    transform: rotateX(-180deg);
    transition: transform 500ms ease-in-out;
  }

  .aster-flipdown__rotor-leaf-front,
  .aster-flipdown__rotor-leaf-rear {
    position: absolute;
    overflow: hidden;
    left: 0;
    top: 0;
    width: 42px;
    height: 33px;
    margin: 0;
    color: #e6d3bd;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .aster-flipdown__rotor-leaf-front {
    line-height: 66px;
    border-radius: 8px 8px 0 0;
    background: var(--aster-rotor-top-bg);
    transform: rotateX(0deg) translateZ(.15px);
  }

  .aster-flipdown__rotor-leaf-rear {
    line-height: 0;
    border-radius: 0 0 8px 8px;
    background: var(--aster-rotor-bottom-bg);
    transform: rotateX(-180deg) translateZ(.15px);
  }

  .aster-flipdown__rotor::after {
    content: '';
    position: absolute;
    z-index: 6;
    bottom: 0;
    left: 0;
    width: 42px;
    height: 33px;
    border-top: 1px solid rgba(230, 211, 189, .10);
    border-radius: 0 0 8px 8px;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .aster-flipdown {
      margin-top: clamp(14px, 2dvh, 18px);
    }

    .aster-flipdown__group {
      gap: 3px;
      padding-right: 12px;
    }

    .aster-flipdown__group:nth-child(2)::before,
    .aster-flipdown__group:nth-child(2)::after,
    .aster-flipdown__group:nth-child(3)::before,
    .aster-flipdown__group:nth-child(3)::after {
      right: 4px;
      width: 3px;
      height: 3px;
    }

    .aster-flipdown__group:nth-child(2)::before,
    .aster-flipdown__group:nth-child(3)::before {
      top: 37px;
    }

    .aster-flipdown__group:nth-child(2)::after,
    .aster-flipdown__group:nth-child(3)::after {
      top: 51px;
    }

    .aster-flipdown__heading {
      height: 20px;
      font-size: 8px;
      line-height: 20px;
    }

    .aster-flipdown__rotor,
    .aster-flipdown__rotor-leaf {
      width: 30px;
      height: 50px;
      border-radius: 6px;
    }

    .aster-flipdown__rotor {
      font-size: 25px;
    }

    .aster-flipdown__rotor-top,
    .aster-flipdown__rotor-bottom,
    .aster-flipdown__rotor-leaf-front,
    .aster-flipdown__rotor-leaf-rear {
      width: 30px;
      height: 25px;
    }

    .aster-flipdown__rotor-top,
    .aster-flipdown__rotor-leaf-front {
      line-height: 50px;
      border-radius: 6px 6px 0 0;
    }

    .aster-flipdown__rotor-bottom,
    .aster-flipdown__rotor-leaf-rear {
      border-radius: 0 0 6px 6px;
    }

    .aster-flipdown__rotor::after {
      width: 30px;
      height: 25px;
      border-radius: 0 0 6px 6px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aster-flipdown {
      transition: none !important;
    }

    .aster-flipdown__rotor-leaf,
    .aster-flipdown__rotor-leaf.is-flipped {
      transition: none !important;
    }
  }
</style>

<script>
  (() => {
    const controller = document.getElementById('AsterCountdownGate-{{ section.id }}');
    if (!controller) return;

    if (
      window.__asterCountdownGateController &&
      typeof window.__asterCountdownGateController.destroy === 'function'
    ) {
      window.__asterCountdownGateController.destroy();
    }

    const enabled = controller.dataset.enabled === 'true';
    const targetTime = Date.parse(controller.dataset.target || '');
    const landing = document.querySelector('[data-aster-landing]');
    const panel = landing?.querySelector('.aster-landing__panel') || null;
    const heading = landing?.querySelector('.aster-landing__heading') || null;
    const form = landing?.querySelector('#AsterWaitingListForm') || null;
    const privacy = landing?.querySelector('.aster-landing__privacy') || null;
    const submitButton = form?.querySelector('[data-aster-waitlist-button]') || null;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const originalHeadingText = heading?.textContent || '';

    if (!landing || !panel || !form || !Number.isFinite(targetTime)) return;

    let intervalId = null;
    let display = null;
    let gateOpen = false;
    let destroyed = false;
    let previousDigits = [];
    const flipTimers = new Set();

    const pad = (value, length = 2) => String(Math.max(0, value)).padStart(length, '0');

    const getClockState = () => {
      const remaining = Math.max(0, targetTime - Date.now());
      const totalSeconds = Math.floor(remaining / 1000);
      const days = Math.floor(totalSeconds / 86400);
      const hours = Math.floor((totalSeconds % 86400) / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const seconds = totalSeconds % 60;

      return {
        remaining,
        days,
        hours,
        minutes,
        seconds,
        digits: `${pad(days)}${pad(hours)}${pad(minutes)}${pad(seconds)}`.split('')
      };
    };

    const createRotor = () => {
      const rotor = document.createElement('div');
      rotor.className = 'aster-flipdown__rotor';
      rotor.innerHTML = `
        <div class="aster-flipdown__rotor-leaf" data-aster-rotor-leaf>
          <figure class="aster-flipdown__rotor-leaf-rear" data-aster-rotor-rear>0</figure>
          <figure class="aster-flipdown__rotor-leaf-front" data-aster-rotor-front>0</figure>
        </div>
        <div class="aster-flipdown__rotor-top" data-aster-rotor-top>0</div>
        <div class="aster-flipdown__rotor-bottom" data-aster-rotor-bottom>0</div>
      `;
      return rotor;
    };

    const createGroup = (label, count) => {
      const group = document.createElement('div');
      group.className = 'aster-flipdown__group';

      const groupHeading = document.createElement('div');
      groupHeading.className = 'aster-flipdown__heading';
      groupHeading.textContent = label;
      group.appendChild(groupHeading);

      for (let index = 0; index < count; index += 1) {
        group.appendChild(createRotor());
      }

      return group;
    };

    const createDisplay = () => {
      const element = document.createElement('div');
      element.className = 'aster-flipdown';
      element.setAttribute('role', 'timer');
      element.setAttribute('aria-label', 'Waiting list opening countdown');
      element.appendChild(createGroup('Days', 2));
      element.appendChild(createGroup('Hours', 2));
      element.appendChild(createGroup('Minutes', 2));
      element.appendChild(createGroup('Seconds', 2));
      panel.appendChild(element);
      return element;
    };

    const setFormLocked = (locked) => {
      if (locked) {
        landing.classList.add('aster-countdown-gate--active');
        form.setAttribute('aria-hidden', 'true');
        form.inert = true;

        if (heading) {
          heading.textContent = 'Waiting list opens in:';
        }

        if (privacy) {
          privacy.setAttribute('aria-hidden', 'true');
        }

        if (submitButton) {
          submitButton.disabled = true;
        }

        return;
      }

      landing.classList.remove('aster-countdown-gate--active');
      form.removeAttribute('aria-hidden');
      form.inert = false;

      if (heading && originalHeadingText) {
        heading.textContent = originalHeadingText;
      }

      if (privacy) {
        privacy.removeAttribute('aria-hidden');
      }

      if (submitButton) {
        submitButton.disabled = false;
      }
    };

    const getRotors = () => {
      if (!display) return [];
      return Array.from(display.querySelectorAll('.aster-flipdown__rotor'));
    };

    const getRotorFaces = (rotor) => ({
      leaf: rotor.querySelector('[data-aster-rotor-leaf]'),
      front: rotor.querySelector('[data-aster-rotor-front]'),
      rear: rotor.querySelector('[data-aster-rotor-rear]'),
      top: rotor.querySelector('[data-aster-rotor-top]'),
      bottom: rotor.querySelector('[data-aster-rotor-bottom]')
    });

    const setRotorInstant = (rotor, value) => {
      const faces = getRotorFaces(rotor);
      if (!faces.leaf || !faces.front || !faces.rear || !faces.top || !faces.bottom) return;

      faces.leaf.classList.remove('is-flipped');
      faces.front.textContent = value;
      faces.rear.textContent = value;
      faces.top.textContent = value;
      faces.bottom.textContent = value;
    };

    const flipRotor = (rotor, previousValue, nextValue) => {
      if (previousValue === nextValue) return;

      const faces = getRotorFaces(rotor);
      if (!faces.leaf || !faces.front || !faces.rear || !faces.top || !faces.bottom) return;

      if (reducedMotion) {
        setRotorInstant(rotor, nextValue);
        return;
      }

      faces.leaf.classList.remove('is-flipped');
      faces.front.textContent = previousValue;
      faces.top.textContent = previousValue;
      faces.bottom.textContent = previousValue;
      faces.rear.textContent = nextValue;

      void faces.leaf.offsetWidth;

      requestAnimationFrame(() => {
        if (destroyed || gateOpen) return;

        faces.leaf.classList.add('is-flipped');

        const revealTopTimer = window.setTimeout(() => {
          faces.top.textContent = nextValue;
          window.clearTimeout(revealTopTimer);
          flipTimers.delete(revealTopTimer);
        }, 210);

        const settleTimer = window.setTimeout(() => {
          faces.front.textContent = nextValue;
          faces.top.textContent = nextValue;
          faces.bottom.textContent = nextValue;
          faces.rear.textContent = nextValue;
          faces.leaf.classList.remove('is-flipped');
          window.clearTimeout(settleTimer);
          flipTimers.delete(settleTimer);
        }, 510);

        flipTimers.add(revealTopTimer);
        flipTimers.add(settleTimer);
      });
    };

    const renderCountdown = (initial = false) => {
      if (!display || gateOpen || destroyed) return;

      const state = getClockState();

      if (state.remaining <= 0) {
        openGate();
        return;
      }

      const rotors = getRotors();

      state.digits.forEach((digit, index) => {
        const rotor = rotors[index];
        if (!rotor) return;

        const previous = previousDigits[index] ?? digit;

        if (initial) {
          setRotorInstant(rotor, digit);
        } else if (previous !== digit) {
          flipRotor(rotor, previous, digit);
        }
      });

      previousDigits = state.digits.slice();

      display.setAttribute(
        'aria-label',
        `Waiting list opens in ${state.days} days, ${state.hours} hours, ${state.minutes} minutes and ${state.seconds} seconds`
      );
    };

    function openGate() {
      if (gateOpen || destroyed) return;
      gateOpen = true;

      if (intervalId) {
        window.clearInterval(intervalId);
        intervalId = null;
      }

      flipTimers.forEach((timerId) => window.clearTimeout(timerId));
      flipTimers.clear();

      if (display) {
        display.classList.add('is-releasing');
      }

      window.setTimeout(() => {
        if (display?.isConnected) {
          display.remove();
        }

        display = null;
        setFormLocked(false);
        window.dispatchEvent(new Event('resize'));
      }, 320);
    }

    const blockLockedInteraction = (event) => {
      if (gateOpen || destroyed) return;
      const target = event.target;
      if (!(target instanceof Node)) return;

      if (form.contains(target)) {
        event.preventDefault();
        event.stopImmediatePropagation();
      }
    };

    const destroy = () => {
      destroyed = true;

      if (intervalId) {
        window.clearInterval(intervalId);
        intervalId = null;
      }

      flipTimers.forEach((timerId) => window.clearTimeout(timerId));
      flipTimers.clear();

      document.removeEventListener('click', blockLockedInteraction, true);
      document.removeEventListener('submit', blockLockedInteraction, true);

      if (display?.isConnected) {
        display.remove();
      }

      setFormLocked(false);
    };

    window.__asterCountdownGateController = { destroy };

    if (!enabled || Date.now() >= targetTime) {
      gateOpen = true;
      setFormLocked(false);
      return;
    }

    display = createDisplay();
    setFormLocked(true);
    renderCountdown(true);

    intervalId = window.setInterval(() => renderCountdown(false), 1000);

    document.addEventListener('click', blockLockedInteraction, true);
    document.addEventListener('submit', blockLockedInteraction, true);
  })();
</script>

{% schema %}
{
  "name": "ASTER launch countdown",
  "tag": "section",
  "class": "section-aster-countdown-gate",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_countdown_gate",
      "label": "Show countdown before launch",
      "default": true,
      "info": "Counts down to 1 November 2026 at 9:00am UK time. Turn this off to reveal and work on the signup form."
    }
  ],
  "presets": [
    {
      "name": "ASTER launch countdown"
    }
  ]
}
{% endschema %}