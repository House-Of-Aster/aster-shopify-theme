[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Branding",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Upload a square image. PNG is recommended; 32 × 32 px or larger."
      }
    ]
  },
  {
    "name": "ASTER landing page",
    "settings": [
      {
        "type": "header",
        "content": "Bear silhouette"
      },
      {
        "type": "image_picker",
        "id": "aster_bear_image",
        "label": "Bear silhouette image",
        "info": "Upload a transparent PNG or WebP. This layer appears directly above the background and behind the canopy, ASTER logo and countdown/form."
      },
      {
        "type": "range",
        "id": "aster_bear_x_desktop",
        "label": "Bear horizontal position desktop",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%",
        "default": 50
      },
      {
        "type": "range",
        "id": "aster_bear_y_desktop",
        "label": "Bear vertical position desktop",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%",
        "default": 50
      },
      {
        "type": "range",
        "id": "aster_bear_scale_desktop",
        "label": "Bear scale desktop",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "%",
        "default": 30,
        "info": "Controls the silhouette width as a percentage of the desktop viewport."
      },
      {
        "type": "range",
        "id": "aster_bear_x_mobile",
        "label": "Bear horizontal position mobile",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%",
        "default": 50
      },
      {
        "type": "range",
        "id": "aster_bear_y_mobile",
        "label": "Bear vertical position mobile",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%",
        "default": 50
      },
      {
        "type": "range",
        "id": "aster_bear_scale_mobile",
        "label": "Bear scale mobile",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "%",
        "default": 60,
        "info": "Controls the silhouette width as a percentage of the mobile viewport."
      }
    ]
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "t:labels.foreground"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  }
]
