[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "color",
        "id": "logo_colour",
        "label": "Logo colour",
        "default": "#6B2331"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Desktop width",
        "min": 60,
        "max": 300,
        "step": 5,
        "unit": "px",
        "default": 170
      },
      {
        "type": "range",
        "id": "logo_mobile_width",
        "label": "Mobile width",
        "min": 60,
        "max": 240,
        "step": 5,
        "unit": "px",
        "default": 130
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image",
        "info": "Upload a square image. It will be rendered at standard browser favicon sizes."
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Body"
      },
      {
        "type": "select",
        "id": "type_body_font_source",
        "label": "Font source",
        "options": [
          { "value": "shopify", "label": "Shopify font" },
          { "value": "british_poems", "label": "British Poems" }
        ],
        "default": "shopify"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
